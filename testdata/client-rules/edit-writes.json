{
  "rule": "editWrites",
  "description": "The field writes the Edit window's Save makes, in order (docs/SPEC.md FR-5.5): one per track whose type, name or description differs from what the server holds, which is what an earlier Save in this window wrote (written), else what it opened with, and any whose last write failed (unsure), which the server may have taken. One track takes all three from the form, type and name trimmed; a group only the type, and an empty type keeps each its own.",
  "cases": [
    { "name": "one track unchanged", "input": {"tracks": [{"id": "a", "trackType": "walking", "name": "Walk", "description": null}], "type": "walking", "name": "Walk", "description": "", "written": [], "unsure": []}, "expected": []},
    { "name": "one track writes all three fields when one changed", "input": {"tracks": [{"id": "a", "trackType": "walking", "name": "Walk", "description": null}], "type": "walking", "name": "Walk", "description": "Steep", "written": [], "unsure": []}, "expected": [{"id": "a", "trackType": "walking", "name": "Walk", "description": "Steep"}]},
    { "name": "a cleared name is written", "input": {"tracks": [{"id": "a", "trackType": "walking", "name": "Walk", "description": null}], "type": "walking", "name": "", "description": "", "written": [], "unsure": []}, "expected": [{"id": "a", "trackType": "walking", "name": "", "description": ""}]},
    { "name": "spaces around the name and type are no change", "input": {"tracks": [{"id": "a", "trackType": "walking", "name": "Walk", "description": null}], "type": " walking ", "name": " Walk ", "description": "", "written": [], "unsure": []}, "expected": []},
    { "name": "the description is kept as typed", "input": {"tracks": [{"id": "a", "trackType": "walking", "name": "Walk", "description": null}], "type": "walking", "name": "Walk", "description": " Steep ", "written": [], "unsure": []}, "expected": [{"id": "a", "trackType": "walking", "name": "Walk", "description": " Steep "}]},
    { "name": "a group writes only the type, each keeping its name and description", "input": {"tracks": [{"id": "a", "trackType": "walking", "name": "Walk", "description": null}, {"id": "b", "trackType": "cycling", "name": null, "description": "Fast"}], "type": "hiking", "name": "ignored", "description": "ignored", "written": [], "unsure": []}, "expected": [{"id": "a", "trackType": "hiking", "name": "Walk", "description": ""}, {"id": "b", "trackType": "hiking", "name": "", "description": "Fast"}]},
    { "name": "not the ones of that type already", "input": {"tracks": [{"id": "a", "trackType": "walking", "name": "Walk", "description": null}, {"id": "c", "trackType": "running", "name": "Run", "description": "Easy"}], "type": "running", "name": "", "description": "", "written": [], "unsure": []}, "expected": [{"id": "a", "trackType": "running", "name": "Walk", "description": ""}]},
    { "name": "an empty type keeps each its own", "input": {"tracks": [{"id": "a", "trackType": "walking", "name": "Walk", "description": null}, {"id": "b", "trackType": "cycling", "name": null, "description": "Fast"}], "type": "", "name": "", "description": "", "written": [], "unsure": []}, "expected": []},
    { "name": "a retry writes only what the first Save didn't", "input": {"tracks": [{"id": "a", "trackType": "walking", "name": "Walk", "description": null}, {"id": "b", "trackType": "cycling", "name": null, "description": "Fast"}], "type": "running", "name": "", "description": "", "written": [{"id": "a", "trackType": "running", "name": "Walk", "description": ""}], "unsure": []}, "expected": [{"id": "b", "trackType": "running", "name": "", "description": "Fast"}]},
    { "name": "a retry of a finished Save writes nothing", "input": {"tracks": [{"id": "a", "trackType": "walking", "name": "Walk", "description": null}, {"id": "b", "trackType": "cycling", "name": null, "description": "Fast"}], "type": "running", "name": "", "description": "", "written": [{"id": "a", "trackType": "running", "name": "Walk", "description": ""}, {"id": "b", "trackType": "running", "name": "", "description": "Fast"}], "unsure": []}, "expected": []},
    { "name": "a retry with another type writes them all", "input": {"tracks": [{"id": "a", "trackType": "walking", "name": "Walk", "description": null}, {"id": "b", "trackType": "cycling", "name": null, "description": "Fast"}], "type": "hiking", "name": "", "description": "", "written": [{"id": "a", "trackType": "running", "name": "Walk", "description": ""}], "unsure": []}, "expected": [{"id": "a", "trackType": "hiking", "name": "Walk", "description": ""}, {"id": "b", "trackType": "hiking", "name": "", "description": "Fast"}]},
    { "name": "one track changed again after its Save is written again", "input": {"tracks": [{"id": "a", "trackType": "walking", "name": "Walk", "description": null}], "type": "walking", "name": "Ridge", "description": "", "written": [{"id": "a", "trackType": "walking", "name": "Hill", "description": ""}], "unsure": []}, "expected": [{"id": "a", "trackType": "walking", "name": "Ridge", "description": ""}]},
    { "name": "and set back to what it was", "input": {"tracks": [{"id": "a", "trackType": "walking", "name": "Walk", "description": null}], "type": "walking", "name": "Walk", "description": "", "written": [{"id": "a", "trackType": "walking", "name": "Hill", "description": ""}], "unsure": []}, "expected": [{"id": "a", "trackType": "walking", "name": "Walk", "description": ""}]},
    { "name": "a track whose write failed is written even set back to what it was", "input": {"tracks": [{"id": "a", "trackType": "walking", "name": "Walk", "description": null}], "type": "walking", "name": "Walk", "description": "", "written": [], "unsure": ["a"]}, "expected": [{"id": "a", "trackType": "walking", "name": "Walk", "description": ""}]},
    { "name": "in a group too, with the type left empty", "input": {"tracks": [{"id": "a", "trackType": "walking", "name": "Walk", "description": null}, {"id": "b", "trackType": "cycling", "name": null, "description": "Fast"}], "type": "", "name": "", "description": "", "written": [], "unsure": ["b"]}, "expected": [{"id": "b", "trackType": "cycling", "name": "", "description": "Fast"}]},
    { "name": "one form of an accent for another is a change", "input": {"tracks": [{"id": "a", "trackType": "walking", "name": "Cafe\u0301", "description": null}], "type": "walking", "name": "Caf\u00e9", "description": "", "written": [], "unsure": []}, "expected": [{"id": "a", "trackType": "walking", "name": "Caf\u00e9", "description": ""}]}
  ]
}
