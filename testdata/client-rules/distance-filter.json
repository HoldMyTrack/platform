{
  "rule": "distanceFilter",
  "description": "The Distance filter after one knob (min or max) moved to value, given the slider's ends (bounds, distanceWholeBounds) and the current band ({ min, max }, the bounds when no filter is on). The value snaps to a whole kilometer or mile in the account's units (system) and stays within the bounds; the other knob holds, the two never cross, and both knobs at the bounds is null, no filter.",
  "tolerance": 1e-6,
  "cases": [
    { "name": "the max knob moved in narrows the filter", "input": { "bounds": { "min": 1000, "max": 17000 }, "current": { "min": 1000, "max": 17000 }, "knob": "max", "value": 12000, "system": "metric" }, "expected": { "min": 1000, "max": 12000 } },
    { "name": "the min knob moved in narrows the filter", "input": { "bounds": { "min": 1000, "max": 17000 }, "current": { "min": 1000, "max": 17000 }, "knob": "min", "value": 5000, "system": "metric" }, "expected": { "min": 5000, "max": 17000 } },
    { "name": "a knob snaps down to a whole kilometer", "input": { "bounds": { "min": 1000, "max": 17000 }, "current": { "min": 1000, "max": 17000 }, "knob": "max", "value": 12345.6, "system": "metric" }, "expected": { "min": 1000, "max": 12000 } },
    { "name": "a knob snaps up to the nearer kilometer", "input": { "bounds": { "min": 1000, "max": 17000 }, "current": { "min": 1000, "max": 17000 }, "knob": "max", "value": 12600, "system": "metric" }, "expected": { "min": 1000, "max": 13000 } },
    { "name": "a knob snaps to a whole mile", "input": { "bounds": { "min": 1609.344, "max": 16093.44 }, "current": { "min": 1609.344, "max": 16093.44 }, "knob": "max", "value": 8000, "system": "imperial" }, "expected": { "min": 1609.344, "max": 8046.72 } },
    { "name": "both knobs back at the bounds is no filter", "input": { "bounds": { "min": 1000, "max": 17000 }, "current": { "min": 1000, "max": 15000 }, "knob": "max", "value": 17000, "system": "metric" }, "expected": null },
    { "name": "a knob moved past its bound is back at it", "input": { "bounds": { "min": 1000, "max": 17000 }, "current": { "min": 1000, "max": 15000 }, "knob": "max", "value": 18000, "system": "metric" }, "expected": null },
    { "name": "one knob back at its end keeps the other one filtering", "input": { "bounds": { "min": 1000, "max": 17000 }, "current": { "min": 5000, "max": 15000 }, "knob": "max", "value": 17000, "system": "metric" }, "expected": { "min": 5000, "max": 17000 } },
    { "name": "the max knob stops at the min one", "input": { "bounds": { "min": 1000, "max": 17000 }, "current": { "min": 5000, "max": 8000 }, "knob": "max", "value": 3000, "system": "metric" }, "expected": { "min": 5000, "max": 5000 } },
    { "name": "the min knob stops at the max one", "input": { "bounds": { "min": 1000, "max": 17000 }, "current": { "min": 5000, "max": 8000 }, "knob": "min", "value": 9000, "system": "metric" }, "expected": { "min": 8000, "max": 8000 } }
  ]
}
