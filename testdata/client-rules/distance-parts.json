{
  "rule": "distanceParts",
  "description": "An activity's distance (meters) in the account's units (system: metric or imperial). Expected: { value, minDecimals, maxDecimals, grouping, unit (km or mi) }, the number each platform writes in its language with that many decimals, thousands grouped or not.",
  "tolerance": 1e-9,
  "cases": [
    { "name": "kilometers, one decimal, never grouped", "input": { "meters": 12345.6, "system": "metric" }, "expected": { "value": 12.3456, "minDecimals": 1, "maxDecimals": 1, "grouping": false, "unit": "km" } },
    { "name": "miles for imperial", "input": { "meters": 16093.44, "system": "imperial" }, "expected": { "value": 10, "minDecimals": 1, "maxDecimals": 1, "grouping": false, "unit": "mi" } },
    { "name": "zero is still one decimal", "input": { "meters": 0, "system": "metric" }, "expected": { "value": 0, "minDecimals": 1, "maxDecimals": 1, "grouping": false, "unit": "km" } },
    { "name": "a long one is not grouped", "input": { "meters": 1234567.8, "system": "metric" }, "expected": { "value": 1234.5678, "minDecimals": 1, "maxDecimals": 1, "grouping": false, "unit": "km" } }
  ]
}