{
  "rule": "panelState",
  "description": "The Activities panel's selection and filters (docs/SPEC.md FR-5): an event on a state over the range's activities, and the state after it. Focusing and the first tick are left out: the web keeps a focus and a checked group side by side, Android takes turns (apps/android/docs/SPEC.md FR-2.7), so no case starts with both. listed is the activities passing the state's filters (passesFilters). State and expected: checked, focused, hidden, excludedTypes, distanceFilter ({ min, max } or null).",
  "cases": [
    {"name": "ticking a row adds it to the group", "input": {"activities": [{"id": "a", "activityType": "walking", "distanceMeters": 1200}, {"id": "b", "activityType": "running", "distanceMeters": 10400}, {"id": "c", "activityType": "cycling", "distanceMeters": 21000}], "state": {"checked": [], "hidden": [], "excludedTypes": []}, "event": {"type": "checkToggled", "id": "a"}}, "expected": {"checked": ["a"], "focused": null, "hidden": [], "excludedTypes": [], "distanceFilter": null}},
    {"name": "ticking a checked row takes it out", "input": {"activities": [{"id": "a", "activityType": "walking", "distanceMeters": 1200}, {"id": "b", "activityType": "running", "distanceMeters": 10400}, {"id": "c", "activityType": "cycling", "distanceMeters": 21000}], "state": {"checked": ["a", "b"], "hidden": [], "excludedTypes": []}, "event": {"type": "checkToggled", "id": "a"}}, "expected": {"checked": ["b"], "focused": null, "hidden": [], "excludedTypes": [], "distanceFilter": null}},
    {"name": "check all ticks the listed rows, never one the filters hide", "input": {"activities": [{"id": "a", "activityType": "walking", "distanceMeters": 1200}, {"id": "b", "activityType": "running", "distanceMeters": 10400}, {"id": "c", "activityType": "cycling", "distanceMeters": 21000}], "state": {"checked": [], "hidden": [], "excludedTypes": ["cycling"]}, "event": {"type": "checkAll"}}, "expected": {"checked": ["a", "b"], "focused": null, "hidden": [], "excludedTypes": ["cycling"], "distanceFilter": null}},
    {"name": "clearing the group keeps the focus", "input": {"activities": [{"id": "a", "activityType": "walking", "distanceMeters": 1200}, {"id": "b", "activityType": "running", "distanceMeters": 10400}, {"id": "c", "activityType": "cycling", "distanceMeters": 21000}], "state": {"checked": [], "hidden": [], "excludedTypes": [], "focused": "c"}, "event": {"type": "checksCleared"}}, "expected": {"checked": [], "focused": "c", "hidden": [], "excludedTypes": [], "distanceFilter": null}},
    {"name": "clearing the group", "input": {"activities": [{"id": "a", "activityType": "walking", "distanceMeters": 1200}, {"id": "b", "activityType": "running", "distanceMeters": 10400}, {"id": "c", "activityType": "cycling", "distanceMeters": 21000}], "state": {"checked": ["a", "b"], "hidden": [], "excludedTypes": []}, "event": {"type": "checksCleared"}}, "expected": {"checked": [], "focused": null, "hidden": [], "excludedTypes": [], "distanceFilter": null}},
    {"name": "inverting flips the listed rows and drops a checked one the filters hide", "input": {"activities": [{"id": "a", "activityType": "walking", "distanceMeters": 1200}, {"id": "b", "activityType": "running", "distanceMeters": 10400}, {"id": "c", "activityType": "cycling", "distanceMeters": 21000}], "state": {"checked": ["a", "c"], "hidden": [], "excludedTypes": ["cycling"]}, "event": {"type": "checksInverted"}}, "expected": {"checked": ["b"], "focused": null, "hidden": [], "excludedTypes": ["cycling"], "distanceFilter": null}},
    {"name": "show/hide hides the whole group when none of it is hidden", "input": {"activities": [{"id": "a", "activityType": "walking", "distanceMeters": 1200}, {"id": "b", "activityType": "running", "distanceMeters": 10400}, {"id": "c", "activityType": "cycling", "distanceMeters": 21000}], "state": {"checked": ["a", "b"], "hidden": [], "excludedTypes": []}, "event": {"type": "visibilityToggled"}}, "expected": {"checked": ["a", "b"], "focused": null, "hidden": ["a", "b"], "excludedTypes": [], "distanceFilter": null}},
    {"name": "show/hide shows the whole group when any of it is hidden", "input": {"activities": [{"id": "a", "activityType": "walking", "distanceMeters": 1200}, {"id": "b", "activityType": "running", "distanceMeters": 10400}, {"id": "c", "activityType": "cycling", "distanceMeters": 21000}], "state": {"checked": ["a", "b"], "hidden": ["b", "c"], "excludedTypes": []}, "event": {"type": "visibilityToggled"}}, "expected": {"checked": ["a", "b"], "focused": null, "hidden": ["c"], "excludedTypes": [], "distanceFilter": null}},
    {"name": "show/hide acts on the focused row with nothing checked", "input": {"activities": [{"id": "a", "activityType": "walking", "distanceMeters": 1200}, {"id": "b", "activityType": "running", "distanceMeters": 10400}, {"id": "c", "activityType": "cycling", "distanceMeters": 21000}], "state": {"checked": [], "hidden": [], "excludedTypes": [], "focused": "c"}, "event": {"type": "visibilityToggled"}}, "expected": {"checked": [], "focused": "c", "hidden": ["c"], "excludedTypes": [], "distanceFilter": null}},
    {"name": "show/hide with no target changes nothing", "input": {"activities": [{"id": "a", "activityType": "walking", "distanceMeters": 1200}, {"id": "b", "activityType": "running", "distanceMeters": 10400}, {"id": "c", "activityType": "cycling", "distanceMeters": 21000}], "state": {"checked": [], "hidden": ["a"], "excludedTypes": []}, "event": {"type": "visibilityToggled"}}, "expected": {"checked": [], "focused": null, "hidden": ["a"], "excludedTypes": [], "distanceFilter": null}},
    {"name": "a type toggles out", "input": {"activities": [{"id": "a", "activityType": "walking", "distanceMeters": 1200}, {"id": "b", "activityType": "running", "distanceMeters": 10400}, {"id": "c", "activityType": "cycling", "distanceMeters": 21000}], "state": {"checked": [], "hidden": [], "excludedTypes": []}, "event": {"type": "typeToggled", "activityType": "running"}}, "expected": {"checked": [], "focused": null, "hidden": [], "excludedTypes": ["running"], "distanceFilter": null}},
    {"name": "a type toggles back in", "input": {"activities": [{"id": "a", "activityType": "walking", "distanceMeters": 1200}, {"id": "b", "activityType": "running", "distanceMeters": 10400}, {"id": "c", "activityType": "cycling", "distanceMeters": 21000}], "state": {"checked": [], "hidden": [], "excludedTypes": ["running", "cycling"]}, "event": {"type": "typeToggled", "activityType": "running"}}, "expected": {"checked": [], "focused": null, "hidden": [], "excludedTypes": ["cycling"], "distanceFilter": null}},
    {"name": "a distance band is set", "input": {"activities": [{"id": "a", "activityType": "walking", "distanceMeters": 1200}, {"id": "b", "activityType": "running", "distanceMeters": 10400}, {"id": "c", "activityType": "cycling", "distanceMeters": 21000}], "state": {"checked": [], "hidden": [], "excludedTypes": []}, "event": {"type": "distanceSet", "filter": {"min": 1000, "max": 11000}}}, "expected": {"checked": [], "focused": null, "hidden": [], "excludedTypes": [], "distanceFilter": {"min": 1000, "max": 11000}}},
    {"name": "a distance band is cleared", "input": {"activities": [{"id": "a", "activityType": "walking", "distanceMeters": 1200}, {"id": "b", "activityType": "running", "distanceMeters": 10400}, {"id": "c", "activityType": "cycling", "distanceMeters": 21000}], "state": {"checked": [], "hidden": [], "excludedTypes": [], "distanceFilter": {"min": 1000, "max": 11000}}, "event": {"type": "distanceSet", "filter": null}}, "expected": {"checked": [], "focused": null, "hidden": [], "excludedTypes": [], "distanceFilter": null}},
    {"name": "reset filters keeps the group and the hidden rows", "input": {"activities": [{"id": "a", "activityType": "walking", "distanceMeters": 1200}, {"id": "b", "activityType": "running", "distanceMeters": 10400}, {"id": "c", "activityType": "cycling", "distanceMeters": 21000}], "state": {"checked": ["a"], "hidden": ["b"], "excludedTypes": ["cycling"], "distanceFilter": {"min": 1000, "max": 11000}}, "event": {"type": "filtersReset"}}, "expected": {"checked": ["a"], "focused": null, "hidden": ["b"], "excludedTypes": [], "distanceFilter": null}},
    {"name": "a new list keeps only what still exists", "input": {"activities": [{"id": "a", "activityType": "walking", "distanceMeters": 1200}, {"id": "b", "activityType": "running", "distanceMeters": 10400}, {"id": "c", "activityType": "cycling", "distanceMeters": 21000}], "state": {"checked": ["a", "b"], "hidden": ["b", "c"], "excludedTypes": []}, "event": {"type": "listLoaded", "ids": ["a", "c"]}}, "expected": {"checked": ["a"], "focused": null, "hidden": ["c"], "excludedTypes": [], "distanceFilter": null}},
    {"name": "a new list without the focused row ends the focus", "input": {"activities": [{"id": "a", "activityType": "walking", "distanceMeters": 1200}, {"id": "b", "activityType": "running", "distanceMeters": 10400}, {"id": "c", "activityType": "cycling", "distanceMeters": 21000}], "state": {"checked": [], "hidden": [], "excludedTypes": ["cycling"], "focused": "b"}, "event": {"type": "listLoaded", "ids": ["a", "c"]}}, "expected": {"checked": [], "focused": null, "hidden": [], "excludedTypes": ["cycling"], "distanceFilter": null}},
    {"name": "a new range starts over, filters included", "input": {"activities": [{"id": "a", "activityType": "walking", "distanceMeters": 1200}, {"id": "b", "activityType": "running", "distanceMeters": 10400}, {"id": "c", "activityType": "cycling", "distanceMeters": 21000}], "state": {"checked": ["a"], "hidden": ["b"], "excludedTypes": ["cycling"], "distanceFilter": {"min": 1000, "max": 11000}}, "event": {"type": "rangePicked", "range": {"from": "2026-10-01", "to": "2026-10-07"}}}, "expected": {"checked": [], "focused": null, "hidden": [], "excludedTypes": [], "distanceFilter": null}}
  ]
}
