{
  "rule": "attachmentName",
  "description": "The file name a download is saved under, from its Content-Disposition header: filename* (RFC 5987: charset'language'value, percent-encoded) before filename, quoted or not. A filename* in a charset other than UTF-8, or malformed, falls back to filename; one with no charset part reads as UTF-8. With neither, or no header, tracks.gpx.",
  "cases": [
    { "name": "a plain quoted name", "input": { "header": "attachment; filename=\"2026-05-01 0800 Ride.gpx\"" }, "expected": "2026-05-01 0800 Ride.gpx" },
    { "name": "an unquoted name", "input": { "header": "attachment; filename=tracks.zip" }, "expected": "tracks.zip" },
    { "name": "filename* wins", "input": { "header": "attachment; filename=\"Ride.gpx\"; filename*=UTF-8''%D0%9F%D1%80%D0%BE%D0%B1%D0%B5%D0%B6%D0%BA%D0%B0.gpx" }, "expected": "Пробежка.gpx" },
    { "name": "filename* alone, as Go writes a non-ASCII name", "input": { "header": "attachment; filename*=utf-8''%D0%9F%D1%80%D0%BE%D0%B1%D0%B5%D0%B6%D0%BA%D0%B0.gpx" }, "expected": "Пробежка.gpx" },
    { "name": "a malformed filename* falls back", "input": { "header": "attachment; filename*=UTF-8''%E0%A4%A; filename=\"Ride.gpx\"" }, "expected": "Ride.gpx" },
    { "name": "a sign is not an escape", "input": { "header": "attachment; filename*=UTF-8''%-1; filename=\"Ride.gpx\"" }, "expected": "Ride.gpx" },
    { "name": "a plus stays a plus", "input": { "header": "attachment; filename*=UTF-8''a+b.gpx" }, "expected": "a+b.gpx" },
    { "name": "a language tag is skipped", "input": { "header": "attachment; filename*=UTF-8'en'Ride.gpx" }, "expected": "Ride.gpx" },
    { "name": "another charset falls back", "input": { "header": "attachment; filename*=ISO-8859-1''Caf%E9.gpx; filename=\"Cafe.gpx\"" }, "expected": "Cafe.gpx" },
    { "name": "no name", "input": { "header": "attachment" }, "expected": "tracks.gpx" },
    { "name": "no header", "input": { "header": null }, "expected": "tracks.gpx" }
  ]
}
