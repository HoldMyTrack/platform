{
  "rule": "satelliteRoads",
  "description": "Whether the basemap's roads come off the map: over satellite imagery (satellite) in Fog and Heatmap, but not Normal (mode: normal, fog, heatmap).",
  "cases": [
    { "name": "off over imagery in Fog", "input": { "satellite": true, "mode": "fog" }, "expected": true },
    { "name": "off over imagery in Heatmap", "input": { "satellite": true, "mode": "heatmap" }, "expected": true },
    { "name": "kept over imagery in Normal", "input": { "satellite": true, "mode": "normal" }, "expected": false },
    { "name": "kept without imagery in Fog", "input": { "satellite": false, "mode": "fog" }, "expected": false },
    { "name": "kept without imagery in Heatmap", "input": { "satellite": false, "mode": "heatmap" }, "expected": false },
    { "name": "kept without imagery in Normal", "input": { "satellite": false, "mode": "normal" }, "expected": false }
  ]
}