{
  "rule": "tourCamera",
  "clients": ["web", "android"],
  "description": "Where the tour's camera goes (docs/SPEC.md FR-4.18): for a step (null for the tour's end), from the camera's state, start (the view before the tour's first move) and shown (the view it last moved to, null where the map took it somewhere unknown), and current, the map's view now. The first step with its own view or on the Stories tab keeps current as start; the Stories tab frames its Story itself, so after it the camera is unknown. A step flies to its own view, else back to start, unless the camera is already there; the end goes back to start the same way and forgets both. move is null for no move. Views compare by lon, lat and zoom.",
  "cases": [
    {"name": "a step without a view moves nothing before the first move", "input": {"start": null, "shown": null, "current": {"lon": -81.8, "lat": 41.4, "zoom": 13}, "step": {"view": null, "tab": "activities"}}, "expected": {"start": null, "shown": null, "move": null}},
    {"name": "the first own view keeps the camera before it and flies there", "input": {"start": null, "shown": null, "current": {"lon": -81.8, "lat": 41.4, "zoom": 13}, "step": {"view": {"lon": -81.72, "lat": 41.42, "zoom": 9}, "tab": "activities"}}, "expected": {"start": {"lon": -81.8, "lat": 41.4, "zoom": 13}, "shown": {"lon": -81.72, "lat": 41.42, "zoom": 9}, "move": {"lon": -81.72, "lat": 41.42, "zoom": 9}}},
    {"name": "the same view again stays", "input": {"start": {"lon": -81.8, "lat": 41.4, "zoom": 13}, "shown": {"lon": -81.72, "lat": 41.42, "zoom": 9}, "current": {"lon": -81.8, "lat": 41.4, "zoom": 13}, "step": {"view": {"lon": -81.72, "lat": 41.42, "zoom": 9}, "tab": "activities"}}, "expected": {"start": {"lon": -81.8, "lat": 41.4, "zoom": 13}, "shown": {"lon": -81.72, "lat": 41.42, "zoom": 9}, "move": null}},
    {"name": "another own view flies there", "input": {"start": {"lon": -81.8, "lat": 41.4, "zoom": 13}, "shown": {"lon": -81.72, "lat": 41.42, "zoom": 9}, "current": {"lon": -81.8, "lat": 41.4, "zoom": 13}, "step": {"view": {"lon": -82, "lat": 36, "zoom": 3.6}, "tab": "activities"}}, "expected": {"start": {"lon": -81.8, "lat": 41.4, "zoom": 13}, "shown": {"lon": -82, "lat": 36, "zoom": 3.6}, "move": {"lon": -82, "lat": 36, "zoom": 3.6}}},
    {"name": "a step without a view after a move goes back", "input": {"start": {"lon": -81.8, "lat": 41.4, "zoom": 13}, "shown": {"lon": -81.72, "lat": 41.42, "zoom": 9}, "current": {"lon": -81.8, "lat": 41.4, "zoom": 13}, "step": {"view": null, "tab": "activities"}}, "expected": {"start": {"lon": -81.8, "lat": 41.4, "zoom": 13}, "shown": {"lon": -81.8, "lat": 41.4, "zoom": 13}, "move": {"lon": -81.8, "lat": 41.4, "zoom": 13}}},
    {"name": "the Stories tab keeps the camera before it and leaves where it goes unknown", "input": {"start": null, "shown": null, "current": {"lon": -81.8, "lat": 41.4, "zoom": 13}, "step": {"view": null, "tab": "stories"}}, "expected": {"start": {"lon": -81.8, "lat": 41.4, "zoom": 13}, "shown": null, "move": null}},
    {"name": "after the Stories tab, a step without a view goes back", "input": {"start": {"lon": -81.8, "lat": 41.4, "zoom": 13}, "shown": null, "current": {"lon": -81.8, "lat": 41.4, "zoom": 13}, "step": {"view": null, "tab": "activities"}}, "expected": {"start": {"lon": -81.8, "lat": 41.4, "zoom": 13}, "shown": {"lon": -81.8, "lat": 41.4, "zoom": 13}, "move": {"lon": -81.8, "lat": 41.4, "zoom": 13}}},
    {"name": "after the Stories tab, an own view flies there", "input": {"start": {"lon": -81.8, "lat": 41.4, "zoom": 13}, "shown": null, "current": {"lon": -81.8, "lat": 41.4, "zoom": 13}, "step": {"view": {"lon": -81.72, "lat": 41.42, "zoom": 9}, "tab": "activities"}}, "expected": {"start": {"lon": -81.8, "lat": 41.4, "zoom": 13}, "shown": {"lon": -81.72, "lat": 41.42, "zoom": 9}, "move": {"lon": -81.72, "lat": 41.42, "zoom": 9}}},
    {"name": "the end goes back after a move", "input": {"start": {"lon": -81.8, "lat": 41.4, "zoom": 13}, "shown": {"lon": -81.72, "lat": 41.42, "zoom": 9}, "current": {"lon": -81.8, "lat": 41.4, "zoom": 13}, "step": null}, "expected": {"start": null, "shown": null, "move": {"lon": -81.8, "lat": 41.4, "zoom": 13}}},
    {"name": "the end stays when the camera is back", "input": {"start": {"lon": -81.8, "lat": 41.4, "zoom": 13}, "shown": {"lon": -81.8, "lat": 41.4, "zoom": 13}, "current": {"lon": -81.8, "lat": 41.4, "zoom": 13}, "step": null}, "expected": {"start": null, "shown": null, "move": null}},
    {"name": "the end goes back when the camera is unknown", "input": {"start": {"lon": -81.8, "lat": 41.4, "zoom": 13}, "shown": null, "current": {"lon": -81.8, "lat": 41.4, "zoom": 13}, "step": null}, "expected": {"start": null, "shown": null, "move": {"lon": -81.8, "lat": 41.4, "zoom": 13}}},
    {"name": "the end moves nothing when nothing moved", "input": {"start": null, "shown": null, "current": {"lon": -81.8, "lat": 41.4, "zoom": 13}, "step": null}, "expected": {"start": null, "shown": null, "move": null}}
  ]
}
