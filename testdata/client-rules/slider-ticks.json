{
  "rule": "sliderTicks",
  "description": "A tick on every slot boundary 0..n: tall (month) where a month starts, the outer two plain. month is the month labelled from that boundary: each month start, and the first month in view at the left edge, unless the next label starts less than 2 slots after it, where the earlier one is dropped.",
  "cases": [
    {"name": "month labels at the left edge and where a month starts", "input": {"days": ["2026-09-28", "2026-09-30", "2026-10-01", "2026-10-02", "2026-10-05", "2026-10-07"]}, "expected": [{"boundary": 0, "kind": "day", "month": 9}, {"boundary": 1, "kind": "day", "month": null}, {"boundary": 2, "kind": "month", "month": 10}, {"boundary": 3, "kind": "day", "month": null}, {"boundary": 4, "kind": "day", "month": null}, {"boundary": 5, "kind": "day", "month": null}, {"boundary": 6, "kind": "day", "month": null}]},
    {"name": "a month starting at the left edge is plain there, but labelled", "input": {"days": ["2026-10-01", "2026-10-03"]}, "expected": [{"boundary": 0, "kind": "day", "month": 10}, {"boundary": 1, "kind": "day", "month": null}, {"boundary": 2, "kind": "day", "month": null}]},
    {"name": "a new year is a new month, the left edge's name giving way to it", "input": {"days": ["2025-12-30", "2026-01-02"]}, "expected": [{"boundary": 0, "kind": "day", "month": null}, {"boundary": 1, "kind": "month", "month": 1}, {"boundary": 2, "kind": "day", "month": null}]},
    {"name": "the same month in another year, the left edge's name giving way to it", "input": {"days": ["2025-10-30", "2026-10-02"]}, "expected": [{"boundary": 0, "kind": "day", "month": null}, {"boundary": 1, "kind": "month", "month": 10}, {"boundary": 2, "kind": "day", "month": null}]},
    {"name": "an empty window has none", "input": {"days": []}, "expected": []},
    {"name": "the left edge's month gives way to one starting a slot in", "input": {"days": ["2026-08-31", "2026-09-02", "2026-09-05", "2026-10-01"]}, "expected": [{"boundary": 0, "kind": "day", "month": null}, {"boundary": 1, "kind": "month", "month": 9}, {"boundary": 2, "kind": "day", "month": null}, {"boundary": 3, "kind": "month", "month": 10}, {"boundary": 4, "kind": "day", "month": null}]},
    {"name": "two slots in, both are labelled", "input": {"days": ["2026-08-30", "2026-08-31", "2026-09-02"]}, "expected": [{"boundary": 0, "kind": "day", "month": 8}, {"boundary": 1, "kind": "day", "month": null}, {"boundary": 2, "kind": "month", "month": 9}, {"boundary": 3, "kind": "day", "month": null}]},
    {"name": "a month with one day in view gives way to the next", "input": {"days": ["2026-08-20", "2026-08-25", "2026-09-30", "2026-10-01", "2026-10-03"]}, "expected": [{"boundary": 0, "kind": "day", "month": 8}, {"boundary": 1, "kind": "day", "month": null}, {"boundary": 2, "kind": "month", "month": null}, {"boundary": 3, "kind": "month", "month": 10}, {"boundary": 4, "kind": "day", "month": null}, {"boundary": 5, "kind": "day", "month": null}]}
  ]
}
