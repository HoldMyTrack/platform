    {"name": "clamped at MIN_DAYS", "input": {"width": 100, "finePointer": false}, "expected": {"buttons": false, "days": 7}},
    {"name": "clamped at MAX_DAYS", "input": {"width": 2000, "finePointer": false}, "expected": {"buttons": true, "days": 31}},
    {"name": "a mouse always gets « », even when narrow", "input": {"width": 200, "finePointer": true}, "expected": {"buttons": true, "days": 7}}
