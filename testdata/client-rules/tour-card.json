{
  "rule": "tourCard",
  "clients": ["web", "android"],
  "description": "The first-time card a user's own pick earns (docs/SPEC.md FR-4.14): \"fog\" for Fog, \"trips\" for the Trips tab; null for Normal, any other tab, a card already seen (seen.cards), or while the tour runs (touring), whose steps say the same.",
  "cases": [
    { "name": "Fog", "input": { "event": { "kind": "mode", "mode": "fog" }, "seen": { "tour": false, "cards": [] }, "touring": false }, "expected": "fog" },
    { "name": "Normal earns nothing", "input": { "event": { "kind": "mode", "mode": "normal" }, "seen": { "tour": false, "cards": [] }, "touring": false }, "expected": null },
    { "name": "the Trips tab", "input": { "event": { "kind": "tab", "tab": "trips" }, "seen": { "tour": false, "cards": [] }, "touring": false }, "expected": "trips" },
    { "name": "another tab earns nothing", "input": { "event": { "kind": "tab", "tab": "tracks" }, "seen": { "tour": false, "cards": [] }, "touring": false }, "expected": null },
    { "name": "a card seen once isn't shown again", "input": { "event": { "kind": "mode", "mode": "fog" }, "seen": { "tour": true, "cards": ["fog"] }, "touring": false }, "expected": null },
    { "name": "another card still shows", "input": { "event": { "kind": "tab", "tab": "trips" }, "seen": { "tour": true, "cards": ["fog"] }, "touring": false }, "expected": "trips" },
    { "name": "nothing while the tour runs", "input": { "event": { "kind": "mode", "mode": "fog" }, "seen": { "tour": true, "cards": [] }, "touring": true }, "expected": null }
  ]
}
