{
  "rule": "recordingSendFailure",
  "description": "What a failed request for one recording means (apps/docs/SPEC.md FR-5.2). outcome: stop, every recording would meet it, and the rest waits; next, this one waits and the rest goes on; refuse, the answer is about the recording, which waits for Retry. answer is a status, \"none\" for no answer, or \"unreadable\". unanswered says the server said nothing: the recording's fault, too long to upload or to handle, or the connection's, so two in a row (afterUnanswered) stop the send.",
  "clients": ["android", "ios"],
  "cases": [
    { "name": "no answer may be the recording's", "input": { "answer": "none", "afterUnanswered": false }, "expected": { "outcome": "next", "unanswered": true } },
    { "name": "a second in a row is the connection's", "input": { "answer": "none", "afterUnanswered": true }, "expected": { "outcome": "stop", "unanswered": true } },
    { "name": "408 counts as no answer", "input": { "answer": 408, "afterUnanswered": false }, "expected": { "outcome": "next", "unanswered": true } },
    { "name": "408 after no answer", "input": { "answer": 408, "afterUnanswered": true }, "expected": { "outcome": "stop", "unanswered": true } },
    { "name": "502 counts as no answer", "input": { "answer": 502, "afterUnanswered": false }, "expected": { "outcome": "next", "unanswered": true } },
    { "name": "502 after no answer", "input": { "answer": 502, "afterUnanswered": true }, "expected": { "outcome": "stop", "unanswered": true } },
    { "name": "504 counts as no answer", "input": { "answer": 504, "afterUnanswered": false }, "expected": { "outcome": "next", "unanswered": true } },
    { "name": "504 after no answer", "input": { "answer": 504, "afterUnanswered": true }, "expected": { "outcome": "stop", "unanswered": true } },
    { "name": "400 is about the recording", "input": { "answer": 400, "afterUnanswered": false }, "expected": { "outcome": "refuse", "unanswered": false } },
    { "name": "400 after no answer", "input": { "answer": 400, "afterUnanswered": true }, "expected": { "outcome": "refuse", "unanswered": false } },
    { "name": "413 is about the recording", "input": { "answer": 413, "afterUnanswered": false }, "expected": { "outcome": "refuse", "unanswered": false } },
    { "name": "413 after no answer", "input": { "answer": 413, "afterUnanswered": true }, "expected": { "outcome": "refuse", "unanswered": false } },
    { "name": "422 is about the recording", "input": { "answer": 422, "afterUnanswered": false }, "expected": { "outcome": "refuse", "unanswered": false } },
    { "name": "422 after no answer", "input": { "answer": 422, "afterUnanswered": true }, "expected": { "outcome": "refuse", "unanswered": false } },
    { "name": "500 may be the recording's", "input": { "answer": 500, "afterUnanswered": false }, "expected": { "outcome": "next", "unanswered": false } },
    { "name": "500 after no answer", "input": { "answer": 500, "afterUnanswered": true }, "expected": { "outcome": "next", "unanswered": false } },
    { "name": "an answer the app can't read", "input": { "answer": "unreadable", "afterUnanswered": false }, "expected": { "outcome": "next", "unanswered": false } },
    { "name": "one after no answer", "input": { "answer": "unreadable", "afterUnanswered": true }, "expected": { "outcome": "next", "unanswered": false } },
    { "name": "401, signed out", "input": { "answer": 401, "afterUnanswered": false }, "expected": { "outcome": "stop", "unanswered": false } },
    { "name": "403, not allowed", "input": { "answer": 403, "afterUnanswered": false }, "expected": { "outcome": "stop", "unanswered": false } },
    { "name": "404, a proxy's", "input": { "answer": 404, "afterUnanswered": false }, "expected": { "outcome": "stop", "unanswered": false } },
    { "name": "409, an unexpected status", "input": { "answer": 409, "afterUnanswered": false }, "expected": { "outcome": "stop", "unanswered": false } },
    { "name": "421, a proxy's", "input": { "answer": 421, "afterUnanswered": false }, "expected": { "outcome": "stop", "unanswered": false } },
    { "name": "426, an outdated app", "input": { "answer": 426, "afterUnanswered": false }, "expected": { "outcome": "stop", "unanswered": false } },
    { "name": "429, too many", "input": { "answer": 429, "afterUnanswered": false }, "expected": { "outcome": "stop", "unanswered": false } },
    { "name": "501, an unexpected server error", "input": { "answer": 501, "afterUnanswered": false }, "expected": { "outcome": "stop", "unanswered": false } },
    { "name": "503, the server is closed", "input": { "answer": 503, "afterUnanswered": false }, "expected": { "outcome": "stop", "unanswered": false } },
    { "name": "524, a proxy's", "input": { "answer": 524, "afterUnanswered": false }, "expected": { "outcome": "stop", "unanswered": false } }
  ]
}
