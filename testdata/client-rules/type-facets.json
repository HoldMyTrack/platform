{
  "rule": "typeFacets",
  "description": "The Type filter's rows (docs/SPEC.md FR-5.2): each type among the tracks the distance filter ({ min, max } or null) lets through, with its count, busiest first and ties in list order. Tracks are { trackType, distanceMeters (null for none), private }.",
  "cases": [
    { "name": "every type, busiest first", "input": { "tracks": [{ "trackType": "running", "distanceMeters": 10400 }, { "trackType": "walking", "distanceMeters": 1200 }, { "trackType": "cycling", "distanceMeters": 21000 }, { "trackType": "walking", "distanceMeters": null }], "distanceFilter": null }, "expected": [{ "type": "walking", "count": 2 }, { "type": "running", "count": 1 }, { "type": "cycling", "count": 1 }] },
    { "name": "counted after the distance filter", "input": { "tracks": [{ "trackType": "walking", "distanceMeters": 1200 }, { "trackType": "running", "distanceMeters": 10400 }, { "trackType": "walking", "distanceMeters": null }], "distanceFilter": { "min": 0, "max": 5000 } }, "expected": [{ "type": "walking", "count": 1 }] },
    { "name": "none with no tracks", "input": { "tracks": [], "distanceFilter": null }, "expected": [] }
  ]
}