{
  "rule": "basemapStatus",
  "clients": ["web", "android"],
  "description": "Whether the map says its basemap can't be reached (docs/SPEC.md FR-4.5): \"loaded\" once any basemap tile has arrived, \"unreachable\" when a basemap request failed before that or 15 seconds of the map on screen passed without one, \"loading\" otherwise. A tile arriving later takes the notice down.",
  "cases": [
    { "name": "loading at first", "input": { "loaded": false, "failed": false, "waitedMs": 0 }, "expected": "loading" },
    { "name": "loading just under the wait", "input": { "loaded": false, "failed": false, "waitedMs": 14999 }, "expected": "loading" },
    { "name": "unreachable at the wait", "input": { "loaded": false, "failed": false, "waitedMs": 15000 }, "expected": "unreachable" },
    { "name": "unreachable on a failure before the wait", "input": { "loaded": false, "failed": true, "waitedMs": 200 }, "expected": "unreachable" },
    { "name": "loaded once a tile arrived", "input": { "loaded": true, "failed": false, "waitedMs": 500 }, "expected": "loaded" },
    { "name": "loaded when a tile arrives after the wait", "input": { "loaded": true, "failed": false, "waitedMs": 40000 }, "expected": "loaded" },
    { "name": "loaded despite an earlier failure", "input": { "loaded": true, "failed": true, "waitedMs": 3000 }, "expected": "loaded" }
  ]
}