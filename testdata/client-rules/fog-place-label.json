{
  "rule": "fogPlaceLabel",
  "clients": ["web", "android"],
  "description": "What Fog says about an outline the pointer is on (web) or a tap picks (Android), from its tile feature: its name, its kind as its own country files it where the catalog has a word for it (map.fog.type.<type>), else the level's (map.fog.place.<kind>), the places it lies in, whether it's explored, and of each level below it how many of its places the account has explored, worded in its country's word where the catalog has that word's plural. `catalog` is the keys the client's catalog has; null for the sea, an unknown kind or no name.",
  "cases": [
    {"name": "an outline is named with its own kind, the places it lies in and whether it is explored", "input": {"props": {"kind": "city", "type": "town", "name": "Parma", "within": "Cuyahoga County, Ohio", "visited": true}, "catalog": ["map.fog.type.town", "map.fog.type.department", "map.fog.type.state", "map.fog.count.state.other", "map.fog.count.parish.other"]}, "expected": {"name": "Parma", "kindKey": "map.fog.type.town", "within": "Cuyahoga County, Ohio", "visitedKey": "map.fog.place.visited", "counts": []}},
    {"name": "a county takes its country's word", "input": {"props": {"kind": "county", "type": "department", "name": "Calvados", "within": "Normandy"}, "catalog": ["map.fog.type.town", "map.fog.type.department", "map.fog.type.state", "map.fog.count.state.other", "map.fog.count.parish.other"]}, "expected": {"name": "Calvados", "kindKey": "map.fog.type.department", "within": "Normandy", "visitedKey": "map.fog.place.unvisited", "counts": []}},
    {"name": "visited as a string from a JSON round trip", "input": {"props": {"kind": "region", "name": "Ohio", "visited": "false"}, "catalog": ["map.fog.type.town", "map.fog.type.department", "map.fog.type.state", "map.fog.count.state.other", "map.fog.count.parish.other"]}, "expected": {"name": "Ohio", "kindKey": "map.fog.place.region", "within": "", "visitedKey": "map.fog.place.unvisited", "counts": []}},
    {"name": "a kind the catalog has no word for is called by the level", "input": {"props": {"kind": "county", "type": "military_area", "name": "X"}, "catalog": ["map.fog.type.town", "map.fog.type.department", "map.fog.type.state", "map.fog.count.state.other", "map.fog.count.parish.other"]}, "expected": {"name": "X", "kindKey": "map.fog.place.county", "within": "", "visitedKey": "map.fog.place.unvisited", "counts": []}},
    {"name": "no kind of its own: the level", "input": {"props": {"kind": "region", "name": "Aruba"}, "catalog": ["map.fog.type.town", "map.fog.type.department", "map.fog.type.state", "map.fog.count.state.other", "map.fog.count.parish.other"]}, "expected": {"name": "Aruba", "kindKey": "map.fog.place.region", "within": "", "visitedKey": "map.fog.place.unvisited", "counts": []}},
    {"name": "a country lies in nothing", "input": {"props": {"kind": "country", "name": "France"}, "catalog": ["map.fog.type.town", "map.fog.type.department", "map.fog.type.state", "map.fog.count.state.other", "map.fog.count.parish.other"]}, "expected": {"name": "France", "kindKey": "map.fog.place.country", "within": "", "visitedKey": "map.fog.place.unvisited", "counts": []}},
    {"name": "the sea has no label", "input": {"props": {"kind": "sea", "visited": false}, "catalog": ["map.fog.type.town", "map.fog.type.department", "map.fog.type.state", "map.fog.count.state.other", "map.fog.count.parish.other"]}, "expected": null},
    {"name": "an unknown kind has no label", "input": {"props": {"kind": "township", "name": "X"}, "catalog": ["map.fog.type.town", "map.fog.type.department", "map.fog.type.state", "map.fog.count.state.other", "map.fog.count.parish.other"]}, "expected": null},
    {"name": "an empty name has no label", "input": {"props": {"kind": "city", "name": ""}, "catalog": ["map.fog.type.town", "map.fog.type.department", "map.fog.type.state", "map.fog.count.state.other", "map.fog.count.parish.other"]}, "expected": null},
    {"name": "nothing at all has no label", "input": {"props": {}, "catalog": ["map.fog.type.town", "map.fog.type.department", "map.fog.type.state", "map.fog.count.state.other", "map.fog.count.parish.other"]}, "expected": null},
    {"name": "a place counts the places below it in its country's words, else the level's", "input": {"props": {"kind": "country", "name": "X", "visited": true, "regions": 9, "regions_total": 56, "counties": 120, "counties_total": 3142, "cities": 840, "cities_total": 29858, "region_word": "state", "county_word": "county"}, "catalog": ["map.fog.type.town", "map.fog.type.department", "map.fog.type.state", "map.fog.count.state.other", "map.fog.count.parish.other"]}, "expected": {"name": "X", "kindKey": "map.fog.place.country", "within": "", "visitedKey": "map.fog.place.visited", "counts": [{"key": "map.fog.count.state", "explored": 9, "total": 56}, {"key": "map.fog.count.county", "explored": 120, "total": 3142}, {"key": "map.fog.count.city", "explored": 840, "total": 29858}]}},
    {"name": "a county word with a plural in the catalog", "input": {"props": {"kind": "country", "name": "X", "visited": true, "counties": 3, "counties_total": 4, "county_word": "parish"}, "catalog": ["map.fog.type.town", "map.fog.type.department", "map.fog.type.state", "map.fog.count.state.other", "map.fog.count.parish.other"]}, "expected": {"name": "X", "kindKey": "map.fog.place.country", "within": "", "visitedKey": "map.fog.place.visited", "counts": [{"key": "map.fog.count.parish", "explored": 3, "total": 4}]}},
    {"name": "a level with no places is left out", "input": {"props": {"kind": "country", "name": "X", "visited": true, "regions": 0, "regions_total": 0, "cities": 2, "cities_total": 5}, "catalog": ["map.fog.type.town", "map.fog.type.department", "map.fog.type.state", "map.fog.count.state.other", "map.fog.count.parish.other"]}, "expected": {"name": "X", "kindKey": "map.fog.place.country", "within": "", "visitedKey": "map.fog.place.visited", "counts": [{"key": "map.fog.count.city", "explored": 2, "total": 5}]}}
  ]
}
