{
  "rule": "webPageRoute",
  "clients": ["android", "ios"],
  "description": "Where a navigation in an app's web-page screen (docs/IMPLEMENTATION.md §4.19) goes. A link on another origin opens outside the app; the page's own path stays; the sign-in pages close the screen for the app's session check; / opens the map, on an activity when it names one and its day, after a session check when it ends the first-run Settings; any other path opens outside. Once the screen is leaving, nothing but its own path is acted on again. The base and the link's scheme and authority are compared as given; an empty path is /.",
  "cases": [
    { "name": "the page's own path stays", "input": { "link": { "scheme": "https", "authority": "holdmytrack.com", "path": "/sync" }, "base": { "scheme": "https", "authority": "holdmytrack.com" }, "page": "/sync" }, "expected": "stay" },
    { "name": "its own path with a query stays", "input": { "link": { "scheme": "https", "authority": "holdmytrack.com", "path": "/profile", "activity": "a1", "day": "2026-10-01" }, "base": { "scheme": "https", "authority": "holdmytrack.com" }, "page": "/profile" }, "expected": "stay" },
    { "name": "its own path stays while leaving", "input": { "link": { "scheme": "https", "authority": "holdmytrack.com", "path": "/settings" }, "base": { "scheme": "https", "authority": "holdmytrack.com" }, "page": "/settings", "leaving": true }, "expected": "stay" },
    { "name": "another host opens outside", "input": { "link": { "scheme": "https", "authority": "www.openstreetmap.org", "path": "/copyright" }, "base": { "scheme": "https", "authority": "holdmytrack.com" }, "page": "/about" }, "expected": "outside" },
    { "name": "another scheme on the same host opens outside", "input": { "link": { "scheme": "http", "authority": "holdmytrack.com", "path": "/about" }, "base": { "scheme": "https", "authority": "holdmytrack.com" }, "page": "/about" }, "expected": "outside" },
    { "name": "another port opens outside", "input": { "link": { "scheme": "http", "authority": "10.0.2.2:5173", "path": "/settings" }, "base": { "scheme": "http", "authority": "10.0.2.2:8081" }, "page": "/settings" }, "expected": "outside" },
    { "name": "a mail link opens outside", "input": { "link": { "scheme": "mailto", "authority": null, "path": "hello@holdmytrack.com" }, "base": { "scheme": "https", "authority": "holdmytrack.com" }, "page": "/about" }, "expected": "outside" },
    { "name": "another origin opens outside even while leaving", "input": { "link": { "scheme": "https", "authority": "example.com", "path": "/" }, "base": { "scheme": "https", "authority": "holdmytrack.com" }, "page": "/about", "leaving": true }, "expected": "outside" },
    { "name": "sign-in closes the screen", "input": { "link": { "scheme": "https", "authority": "holdmytrack.com", "path": "/signin" }, "base": { "scheme": "https", "authority": "holdmytrack.com" }, "page": "/settings" }, "expected": "close" },
    { "name": "the verification wait closes the screen", "input": { "link": { "scheme": "https", "authority": "holdmytrack.com", "path": "/verify-pending" }, "base": { "scheme": "https", "authority": "holdmytrack.com" }, "page": "/profile" }, "expected": "close" },
    { "name": "the map closes the screen", "input": { "link": { "scheme": "https", "authority": "holdmytrack.com", "path": "/" }, "base": { "scheme": "https", "authority": "holdmytrack.com" }, "page": "/about" }, "expected": "close" },
    { "name": "an empty path is the map", "input": { "link": { "scheme": "https", "authority": "holdmytrack.com", "path": "" }, "base": { "scheme": "https", "authority": "holdmytrack.com" }, "page": "/about" }, "expected": "close" },
    { "name": "View on map opens the activity", "input": { "link": { "scheme": "https", "authority": "holdmytrack.com", "path": "/", "activity": "8f1c", "day": "2026-09-14" }, "base": { "scheme": "https", "authority": "holdmytrack.com" }, "page": "/sync" }, "expected": { "viewOnMap": { "activity": "8f1c", "day": "2026-09-14" } } },
    { "name": "an activity with no day is the plain map", "input": { "link": { "scheme": "https", "authority": "holdmytrack.com", "path": "/", "activity": "8f1c" }, "base": { "scheme": "https", "authority": "holdmytrack.com" }, "page": "/sync" }, "expected": "close" },
    { "name": "a day with no activity is the plain map", "input": { "link": { "scheme": "https", "authority": "holdmytrack.com", "path": "/", "day": "2026-09-14" }, "base": { "scheme": "https", "authority": "holdmytrack.com" }, "page": "/sync" }, "expected": "close" },
    { "name": "the first run's save opens the map after a session check", "input": { "link": { "scheme": "https", "authority": "holdmytrack.com", "path": "/" }, "base": { "scheme": "https", "authority": "holdmytrack.com" }, "page": "/settings", "onboarding": true }, "expected": "onboarded" },
    { "name": "View on map wins over the first run", "input": { "link": { "scheme": "https", "authority": "holdmytrack.com", "path": "/", "activity": "8f1c", "day": "2026-09-14" }, "base": { "scheme": "https", "authority": "holdmytrack.com" }, "page": "/settings", "onboarding": true }, "expected": { "viewOnMap": { "activity": "8f1c", "day": "2026-09-14" } } },
    { "name": "sign-in during the first run closes the screen", "input": { "link": { "scheme": "https", "authority": "holdmytrack.com", "path": "/signin" }, "base": { "scheme": "https", "authority": "holdmytrack.com" }, "page": "/settings", "onboarding": true }, "expected": "close" },
    { "name": "the map while leaving is ignored", "input": { "link": { "scheme": "https", "authority": "holdmytrack.com", "path": "/" }, "base": { "scheme": "https", "authority": "holdmytrack.com" }, "page": "/settings", "onboarding": true, "leaving": true }, "expected": "ignore" },
    { "name": "sign-in while leaving is ignored", "input": { "link": { "scheme": "https", "authority": "holdmytrack.com", "path": "/signin" }, "base": { "scheme": "https", "authority": "holdmytrack.com" }, "page": "/settings", "leaving": true }, "expected": "ignore" },
    { "name": "another page while leaving is ignored", "input": { "link": { "scheme": "https", "authority": "holdmytrack.com", "path": "/help" }, "base": { "scheme": "https", "authority": "holdmytrack.com" }, "page": "/about", "leaving": true }, "expected": "ignore" },
    { "name": "another page of the site opens outside", "input": { "link": { "scheme": "https", "authority": "holdmytrack.com", "path": "/help" }, "base": { "scheme": "https", "authority": "holdmytrack.com" }, "page": "/about" }, "expected": "outside" },
    { "name": "a page under the page's path opens outside", "input": { "link": { "scheme": "https", "authority": "holdmytrack.com", "path": "/settings/password" }, "base": { "scheme": "https", "authority": "holdmytrack.com" }, "page": "/settings" }, "expected": "outside" }
  ]
}
