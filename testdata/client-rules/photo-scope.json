{
  "rule": "photoScope",
  "description": "Whose photos the map shows, in Normal mode only: the Edit window's single track (none for a group), else the focused track, else the open Trip.",
  "cases": [
    { "name": "Fog shows none", "input": { "mode": "fog", "focused": "a", "tripId": "s" }, "expected": null },
    { "name": "the Edit window's one track", "input": { "mode": "normal", "editWindowIds": ["e"], "focused": "a", "tripId": "s" }, "expected": { "track": "e" } },
    { "name": "an Edit window over a group shows none", "input": { "mode": "normal", "editWindowIds": ["e", "f"], "focused": "a" }, "expected": null },
    { "name": "the focused track over the Trip", "input": { "mode": "normal", "focused": "a", "tripId": "s" }, "expected": { "track": "a" } },
    { "name": "the open Trip", "input": { "mode": "normal", "tripId": "s" }, "expected": { "trip": "s" } },
    { "name": "nothing in view", "input": { "mode": "normal" }, "expected": null }
  ]
}
