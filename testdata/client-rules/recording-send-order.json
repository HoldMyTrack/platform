{
  "rule": "recordingSendOrder",
  "description": "Which of the phone's recordings a send takes, in order (apps/docs/SPEC.md FR-5.2): newest first (startedAt, epoch ms), then those whose last request failed (setBack, the latest last) in that order, or one that stops every send would keep the rest on the phone. None the server has taken (sent), swiped aside (hidden) or open in Save, Edit or Delete's question (held), and none refused since launch unless the user asked again (retry).",
  "clients": ["android", "ios"],
  "cases": [
    { "name": "newest first", "input": { "recordings": [{ "id": "a", "startedAt": 100, "sent": false }, { "id": "b", "startedAt": 200, "sent": false }, { "id": "c", "startedAt": 300, "sent": false }], "hidden": [], "held": [], "refused": [], "setBack": [], "retry": false }, "expected": ["c", "b", "a"] },
    { "name": "whatever order they're listed in", "input": { "recordings": [{ "id": "b", "startedAt": 200, "sent": false }, { "id": "c", "startedAt": 300, "sent": false }, { "id": "a", "startedAt": 100, "sent": false }], "hidden": [], "held": [], "refused": [], "setBack": [], "retry": false }, "expected": ["c", "b", "a"] },
    { "name": "one on its way is never sent twice", "input": { "recordings": [{ "id": "a", "startedAt": 100, "sent": false }, { "id": "b", "startedAt": 200, "sent": true }, { "id": "c", "startedAt": 300, "sent": false }], "hidden": [], "held": [], "refused": [], "setBack": [], "retry": false }, "expected": ["c", "a"] },
    { "name": "nor on Retry", "input": { "recordings": [{ "id": "a", "startedAt": 100, "sent": false }, { "id": "b", "startedAt": 200, "sent": true }, { "id": "c", "startedAt": 300, "sent": false }], "hidden": [], "held": [], "refused": [], "setBack": [], "retry": true }, "expected": ["c", "a"] },
    { "name": "a refused one waits for Retry", "input": { "recordings": [{ "id": "a", "startedAt": 100, "sent": false }, { "id": "b", "startedAt": 200, "sent": false }, { "id": "c", "startedAt": 300, "sent": false }], "hidden": [], "held": [], "refused": ["b"], "setBack": [], "retry": false }, "expected": ["c", "a"] },
    { "name": "and goes on Retry, in its place", "input": { "recordings": [{ "id": "a", "startedAt": 100, "sent": false }, { "id": "b", "startedAt": 200, "sent": false }, { "id": "c", "startedAt": 300, "sent": false }], "hidden": [], "held": [], "refused": ["b"], "setBack": [], "retry": true }, "expected": ["c", "b", "a"] },
    { "name": "one swiped aside isn't sent", "input": { "recordings": [{ "id": "a", "startedAt": 100, "sent": false }, { "id": "b", "startedAt": 200, "sent": false }, { "id": "c", "startedAt": 300, "sent": false }], "hidden": ["b"], "held": [], "refused": [], "setBack": [], "retry": false }, "expected": ["c", "a"] },
    { "name": "not even on Retry", "input": { "recordings": [{ "id": "a", "startedAt": 100, "sent": false }, { "id": "b", "startedAt": 200, "sent": false }, { "id": "c", "startedAt": 300, "sent": false }], "hidden": ["b"], "held": [], "refused": [], "setBack": [], "retry": true }, "expected": ["c", "a"] },
    { "name": "one with a screen open about it isn't sent", "input": { "recordings": [{ "id": "a", "startedAt": 100, "sent": false }, { "id": "b", "startedAt": 200, "sent": false }, { "id": "c", "startedAt": 300, "sent": false }], "hidden": [], "held": ["c"], "refused": [], "setBack": [], "retry": false }, "expected": ["b", "a"] },
    { "name": "not even on Retry", "input": { "recordings": [{ "id": "a", "startedAt": 100, "sent": false }, { "id": "b", "startedAt": 200, "sent": false }, { "id": "c", "startedAt": 300, "sent": false }], "hidden": [], "held": ["c"], "refused": [], "setBack": [], "retry": true }, "expected": ["b", "a"] },
    { "name": "one whose request failed goes last", "input": { "recordings": [{ "id": "a", "startedAt": 100, "sent": false }, { "id": "b", "startedAt": 200, "sent": false }, { "id": "c", "startedAt": 300, "sent": false }], "hidden": [], "held": [], "refused": [], "setBack": ["c"], "retry": false }, "expected": ["b", "a", "c"] },
    { "name": "those that failed go in the order they did", "input": { "recordings": [{ "id": "a", "startedAt": 100, "sent": false }, { "id": "b", "startedAt": 200, "sent": false }, { "id": "c", "startedAt": 300, "sent": false }], "hidden": [], "held": [], "refused": [], "setBack": ["c", "a"], "retry": false }, "expected": ["b", "c", "a"] },
    { "name": "the latest failure last", "input": { "recordings": [{ "id": "a", "startedAt": 100, "sent": false }, { "id": "b", "startedAt": 200, "sent": false }, { "id": "c", "startedAt": 300, "sent": false }], "hidden": [], "held": [], "refused": [], "setBack": ["a", "c"], "retry": false }, "expected": ["b", "a", "c"] },
    { "name": "a failed one no longer waiting is left out", "input": { "recordings": [{ "id": "a", "startedAt": 100, "sent": false }, { "id": "b", "startedAt": 200, "sent": false }], "hidden": [], "held": [], "refused": [], "setBack": ["c"], "retry": false }, "expected": ["b", "a"] },
    { "name": "a failed one refused since waits for Retry", "input": { "recordings": [{ "id": "a", "startedAt": 100, "sent": false }, { "id": "b", "startedAt": 200, "sent": false }, { "id": "c", "startedAt": 300, "sent": false }], "hidden": [], "held": [], "refused": ["c"], "setBack": ["c"], "retry": false }, "expected": ["b", "a"] },
    { "name": "nothing waiting", "input": { "recordings": [], "hidden": [], "held": [], "refused": [], "setBack": [], "retry": false }, "expected": [] }
  ]
}
