{
  "rule": "rangeShift",
  "description": "Where the date slider's range-shift buttons move a selection, counted in activity-days. Input: days (the loaded activity-days, ascending), hasEarlier, range, dir (-1 or 1). Expected: the shifted range, null when there is nothing further that way, or \"load\" when the days it needs are older than what is loaded.",
  "cases": [
    { "name": "left moves the same number of activity-days, ending just before the old start", "input": { "days": ["2026-09-01", "2026-09-03", "2026-09-06", "2026-09-07", "2026-09-08", "2026-09-09"], "hasEarlier": false, "range": { "from": "2026-09-08", "to": "2026-09-09" }, "dir": -1 }, "expected": { "from": "2026-09-06", "to": "2026-09-07" } },
    { "name": "left counts activity-days, not calendar days", "input": { "days": ["2026-09-01", "2026-09-03", "2026-09-06", "2026-09-07", "2026-09-08", "2026-09-09"], "hasEarlier": false, "range": { "from": "2026-09-06", "to": "2026-09-07" }, "dir": -1 }, "expected": { "from": "2026-09-01", "to": "2026-09-03" } },
    { "name": "right moves the same number of activity-days, starting just after the old end", "input": { "days": ["2026-09-01", "2026-09-03", "2026-09-06", "2026-09-07", "2026-09-08", "2026-09-09"], "hasEarlier": false, "range": { "from": "2026-09-01", "to": "2026-09-03" }, "dir": 1 }, "expected": { "from": "2026-09-06", "to": "2026-09-07" } },
    { "name": "near the start the range keeps its size and stops there", "input": { "days": ["2026-09-01", "2026-09-03", "2026-09-06", "2026-09-07", "2026-09-08", "2026-09-09"], "hasEarlier": false, "range": { "from": "2026-09-03", "to": "2026-09-06" }, "dir": -1 }, "expected": { "from": "2026-09-01", "to": "2026-09-03" } },
    { "name": "near the end the range keeps its size and stops there", "input": { "days": ["2026-09-01", "2026-09-03", "2026-09-06", "2026-09-07", "2026-09-08", "2026-09-09"], "hasEarlier": false, "range": { "from": "2026-09-06", "to": "2026-09-08" }, "dir": 1 }, "expected": { "from": "2026-09-07", "to": "2026-09-09" } },
    { "name": "nothing before the first day", "input": { "days": ["2026-09-01", "2026-09-03", "2026-09-06", "2026-09-07", "2026-09-08", "2026-09-09"], "hasEarlier": false, "range": { "from": "2026-09-01", "to": "2026-09-03" }, "dir": -1 }, "expected": null },
    { "name": "nothing after a range running past the newest day to today", "input": { "days": ["2026-09-01", "2026-09-03", "2026-09-06", "2026-09-07", "2026-09-08", "2026-09-09"], "hasEarlier": false, "range": { "from": "2026-09-07", "to": "2026-10-03" }, "dir": 1 }, "expected": null },
    { "name": "nothing with no activity-days", "input": { "days": [], "hasEarlier": false, "range": { "from": "2026-09-07", "to": "2026-09-08" }, "dir": -1 }, "expected": null },
    { "name": "loads more history before the first loaded day", "input": { "days": ["2026-09-01", "2026-09-03", "2026-09-06", "2026-09-07", "2026-09-08", "2026-09-09"], "hasEarlier": true, "range": { "from": "2026-09-01", "to": "2026-09-03" }, "dir": -1 }, "expected": "load" },
    { "name": "loads more history when the shift would run past the loaded days", "input": { "days": ["2026-09-01", "2026-09-03", "2026-09-06", "2026-09-07", "2026-09-08", "2026-09-09"], "hasEarlier": true, "range": { "from": "2026-09-03", "to": "2026-09-07" }, "dir": -1 }, "expected": "load" },
    { "name": "loads more history when the range starts before the loaded days", "input": { "days": ["2026-09-01", "2026-09-03", "2026-09-06", "2026-09-07", "2026-09-08", "2026-09-09"], "hasEarlier": true, "range": { "from": "2026-08-20", "to": "2026-09-03" }, "dir": 1 }, "expected": "load" },
    { "name": "earlier history doesn't matter when the loaded days suffice", "input": { "days": ["2026-09-01", "2026-09-03", "2026-09-06", "2026-09-07", "2026-09-08", "2026-09-09"], "hasEarlier": true, "range": { "from": "2026-09-08", "to": "2026-09-09" }, "dir": -1 }, "expected": { "from": "2026-09-06", "to": "2026-09-07" } },
    { "name": "a range with no activity-days moves one day left", "input": { "days": ["2026-09-01", "2026-09-03", "2026-09-06", "2026-09-07", "2026-09-08", "2026-09-09"], "hasEarlier": false, "range": { "from": "2026-09-04", "to": "2026-09-05" }, "dir": -1 }, "expected": { "from": "2026-09-03", "to": "2026-09-03" } },
    { "name": "a range with no activity-days moves one day right", "input": { "days": ["2026-09-01", "2026-09-03", "2026-09-06", "2026-09-07", "2026-09-08", "2026-09-09"], "hasEarlier": false, "range": { "from": "2026-09-04", "to": "2026-09-05" }, "dir": 1 }, "expected": { "from": "2026-09-06", "to": "2026-09-06" } }
  ]
}