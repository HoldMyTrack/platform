{
  "rule": "photoMarkerLayout",
  "description": "The photo markers an exported image draws (docs/SPEC.md FR-4.10), grouped and sized as on screen (photoClusters, photoMarkerSize). Points ({ id, x, y }) are in route order, in screen pixels from the frame's top-left; loneId keeps a marker of its own; activeId's marker is larger and drawn last. A marker whose circle lies wholly outside the width × height frame is left out. Expected: { ids, x, y, diameter, active, small }, positions and diameter multiplied by scale (output pixels per screen pixel).",
  "cases": [
    { "name": "none below the zoom tracks start at", "input": { "points": [{ "id": "a", "x": 50, "y": 50 }], "zoom": 3, "width": 100, "height": 100, "scale": 2 }, "expected": [] },
    { "name": "one photo, full size, scaled", "input": { "points": [{ "id": "a", "x": 50, "y": 40 }], "zoom": 12, "width": 100, "height": 100, "scale": 2 }, "expected": [{ "ids": ["a"], "x": 100, "y": 80, "diameter": 72, "active": false, "small": false }] },
    { "name": "overlapping photos are one group at the first", "input": { "points": [{ "id": "a", "x": 50, "y": 50 }, { "id": "b", "x": 70, "y": 50 }], "zoom": 12, "width": 100, "height": 100, "scale": 1 }, "expected": [{ "ids": ["a", "b"], "x": 50, "y": 50, "diameter": 36, "active": false, "small": false }] },
    { "name": "zoomed out the markers are small and group closer", "input": { "points": [{ "id": "a", "x": 50, "y": 50 }, { "id": "b", "x": 70, "y": 50 }], "zoom": 8, "width": 100, "height": 100, "scale": 1 }, "expected": [{ "ids": ["a"], "x": 50, "y": 50, "diameter": 22, "active": false, "small": true }, { "ids": ["b"], "x": 70, "y": 50, "diameter": 22, "active": false, "small": true }] },
    { "name": "the active photo is larger and drawn last", "input": { "points": [{ "id": "a", "x": 20, "y": 20 }, { "id": "b", "x": 80, "y": 80 }], "zoom": 12, "activeId": "a", "width": 100, "height": 100, "scale": 1 }, "expected": [{ "ids": ["b"], "x": 80, "y": 80, "diameter": 36, "active": false, "small": false }, { "ids": ["a"], "x": 20, "y": 20, "diameter": 52, "active": true, "small": false }] },
    { "name": "small and active is full size", "input": { "points": [{ "id": "a", "x": 20, "y": 20 }], "zoom": 8, "activeId": "a", "width": 100, "height": 100, "scale": 1 }, "expected": [{ "ids": ["a"], "x": 20, "y": 20, "diameter": 36, "active": true, "small": true }] },
    { "name": "the lone photo stays out of every group", "input": { "points": [{ "id": "a", "x": 50, "y": 50 }, { "id": "b", "x": 55, "y": 50 }, { "id": "c", "x": 60, "y": 50 }], "zoom": 12, "loneId": "a", "width": 100, "height": 100, "scale": 1 }, "expected": [{ "ids": ["b", "c"], "x": 55, "y": 50, "diameter": 36, "active": false, "small": false }, { "ids": ["a"], "x": 50, "y": 50, "diameter": 36, "active": false, "small": false }] },
    { "name": "a circle partly in the frame is kept; one wholly outside is left out, its group with it", "input": { "points": [{ "id": "a", "x": -20, "y": 50 }, { "id": "b", "x": 5, "y": 50 }, { "id": "c", "x": 110, "y": 50 }], "zoom": 12, "width": 100, "height": 100, "scale": 1 }, "expected": [{ "ids": ["c"], "x": 110, "y": 50, "diameter": 36, "active": false, "small": false }] }
  ]
}
