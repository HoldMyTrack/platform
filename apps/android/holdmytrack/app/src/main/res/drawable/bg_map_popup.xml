<?xml version="1.0" encoding="utf-8"?>
<!-- A popup over the map (a spot's, a Fog place's, a photo's), the web's .spot-popup card: the surface, an
     outline that keeps it apart from a dark map (hmt_map_popup_border), the medium radius. Its
     shadow is the view's elevation. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/hmt_surface" />
    <stroke
        android:width="1dp"
        android:color="@color/hmt_map_popup_border" />
    <corners android:radius="@dimen/hmt_radius_md" />
</shape>
