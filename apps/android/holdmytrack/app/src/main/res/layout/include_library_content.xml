<?xml version="1.0" encoding="utf-8"?>
<!-- The Library tab (panel/LibraryTab): every track the account keeps, a page at a time. The
     search, then the sort and the filters (Type, Dates, Distance, Trip) as chips, how many
     tracks pass, the Checked tracks' bar, the rows, and the pager. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/panel_library_content"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:visibility="gone">

    <!-- The search, and + beside it, opening Sync: how more tracks come in, with the recordings waiting. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/hmt_space_16"
        android:layout_marginTop="@dimen/hmt_space_4"
        android:layout_marginEnd="@dimen/hmt_space_16"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/library_search_hint"
            app:endIconMode="clear_text"
            app:startIconDrawable="@drawable/ic_search">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/library_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLength="200" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- The icon, then the count while recordings wait (panel/LibraryTab.setSyncWaiting). -->
        <Button
            android:id="@+id/library_sync"
            style="@style/Widget.Material3.Button.TonalButton.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/hmt_space_8"
            android:minWidth="48dp"
            android:paddingStart="@dimen/hmt_space_12"
            android:paddingEnd="@dimen/hmt_space_12"
            android:contentDescription="@string/library_add"
            android:tooltipText="@string/library_add"
            app:icon="@drawable/ic_plus"
            app:iconGravity="textStart"
            app:iconPadding="0dp" />
    </LinearLayout>

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/library_chips"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/hmt_space_16"
            android:paddingTop="@dimen/hmt_space_4"
            android:paddingEnd="@dimen/hmt_space_16"
            app:singleLine="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/library_sort"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:chipIcon="@drawable/ic_arrow_up_down"
                tools:text="Newest first" />

            <com.google.android.material.chip.Chip
                android:id="@+id/library_type"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="false"
                android:text="@string/panel_type" />

            <com.google.android.material.chip.Chip
                android:id="@+id/library_dates"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="false"
                android:text="@string/library_dates" />

            <com.google.android.material.chip.Chip
                android:id="@+id/library_distance"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="false"
                android:text="@string/panel_any_distance_chip" />

            <com.google.android.material.chip.Chip
                android:id="@+id/library_trip"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="false"
                android:text="@string/library_trip" />

            <com.google.android.material.chip.Chip
                android:id="@+id/library_reset"
                style="@style/Widget.Material3.Chip.Assist"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/panel_reset"
                android:visibility="gone" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/library_count"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/hmt_space_16"
        android:layout_marginEnd="@dimen/hmt_space_16"
        android:accessibilityLiveRegion="polite"
        android:paddingVertical="@dimen/hmt_space_4"
        android:textColor="@color/hmt_ink_meta"
        android:textSize="@dimen/hmt_text_sm"
        tools:text="142 tracks" />

    <!-- The Checked tracks: how many, Download and Delete, and × to uncheck them. -->
    <LinearLayout
        android:id="@+id/library_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/hmt_surface_tint"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/hmt_space_8"
        android:paddingEnd="@dimen/hmt_space_8"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/library_uncheck"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/library_uncheck"
            android:src="@drawable/ic_x"
            app:tint="@color/hmt_ink" />

        <TextView
            android:id="@+id/library_checked"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/hmt_ink"
            android:textFontWeight="600"
            android:textSize="@dimen/hmt_text_md"
            tools:text="3 checked tracks" />

        <ImageButton
            android:id="@+id/library_download"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/library_download"
            android:src="@drawable/ic_download"
            app:tint="@color/hmt_ink" />

        <ImageButton
            android:id="@+id/library_delete"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/panel_delete_confirm"
            android:src="@drawable/ic_trash_2"
            app:tint="@color/hmt_danger" />
    </LinearLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/library_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/hmt_accent"
        app:trackColor="@color/hmt_surface_tint_strong"
        app:trackThickness="3dp" />

    <TextView
        android:id="@+id/library_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/hmt_space_16"
        android:textAppearance="@style/TextAppearance.HoldMyTrack.CardRowSub"
        android:visibility="gone" />

    <!-- Past the last page, as after deleting the last one's tracks: back to the first. -->
    <Button
        android:id="@+id/library_first_page"
        style="@style/Widget.HoldMyTrack.Button.Link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/hmt_space_8"
        android:minHeight="48dp"
        android:text="@string/library_first_page"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/library_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="vertical" />

    <!-- Previous, which rows these are, Next. -->
    <LinearLayout
        android:id="@+id/library_pager"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_list_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/hmt_space_8"
        android:paddingEnd="@dimen/hmt_space_8"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/library_prev"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/library_prev"
            android:src="@drawable/ic_chevron_left"
            app:tint="@color/hmt_ink" />

        <TextView
            android:id="@+id/library_range"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/hmt_ink_secondary"
            android:textSize="@dimen/hmt_text_sm"
            tools:text="101–200 of 250" />

        <ImageButton
            android:id="@+id/library_next"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/library_next"
            android:src="@drawable/ic_chevron_right"
            app:tint="@color/hmt_ink" />
    </LinearLayout>
</LinearLayout>
