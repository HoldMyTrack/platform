<?xml version="1.0" encoding="utf-8"?>
<!-- Library's Distance filter (panel/LibraryTab.showDistance): the Tracks tab's slider over every
     track's distances, and the band it keeps. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/hmt_space_24"
    android:paddingTop="@dimen/hmt_space_8"
    android:paddingEnd="@dimen/hmt_space_24">

    <TextView
        android:id="@+id/library_distance_readout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite"
        android:textColor="@color/hmt_ink"
        android:textSize="@dimen/hmt_text_md" />

    <com.google.android.material.slider.RangeSlider
        android:id="@+id/library_distance_slider"
        style="@style/Widget.HoldMyTrack.PanelSlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/panel_distance" />
</LinearLayout>
