<?xml version="1.0" encoding="utf-8"?>
<!-- The Edit window (panel/EditTrackWindow.kt), after the web's EditTrackWindow.tsx: a sheet along
     the bottom of the map, the map live above it, so its Route and Photos tabs can edit on the
     map. Its header stays put: Cancel, the title and whose it is, Save. Under it the Track, Route
     and Photos tabs — Type, Name and Description on the first, the route editor (panel/RouteEditor)
     on the second, the photos (panel/PhotosTab) on the third — then an error line, scrolling past
     most of the screen's height. It reaches the screen's bottom edge, its padding clearing the
     gesture bar, or rides on the keyboard while it's up (map/ChromeInsets.placeEditors). Clickable,
     so a touch on it never reaches the map. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/edit_window"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@drawable/bg_sheet"
    android:clickable="true"
    android:elevation="10dp"
    android:focusable="false"
    android:orientation="vertical"
    android:visibility="gone">

    <!-- The header: Cancel, the window's title and whose it is, Save. -->
    <LinearLayout
        android:id="@+id/edit_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/hmt_space_4"
        android:paddingTop="@dimen/hmt_space_8"
        android:paddingEnd="@dimen/hmt_space_12"
        android:paddingBottom="@dimen/hmt_space_4">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/edit_cancel"
            style="@style/Widget.HoldMyTrack.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/edit_cancel" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/hmt_space_4"
            android:layout_marginEnd="@dimen/hmt_space_4"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/edit_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.HoldMyTrack.TitleMedium"
                tools:text="Edit track" />

            <!-- Two lines, so several tracks' sentence and a long name show whole. -->
            <TextView
                android:id="@+id/edit_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="2"
                android:textColor="@color/hmt_ink_meta"
                android:textSize="@dimen/hmt_text_sm"
                tools:text="Sep 24, 2026, 4:00 AM" />
        </LinearLayout>

        <Button
            android:id="@+id/edit_save"
            style="@style/Widget.HoldMyTrack.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/edit_save" />
    </LinearLayout>

    <dev.holdmytrack.android.panel.MaxHeightScrollView
        android:id="@+id/edit_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/hmt_space_16"
        android:paddingEnd="@dimen/hmt_space_16"
        android:paddingBottom="@dimen/hmt_space_16"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- The tabs (.edit-window__tabs): the selected one underlined in the accent, the
                 other dimmed, Track disabled — dimmer still — when it can't apply. -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/edit_tab_track"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_panel_tab_selected"
                        android:clickable="true"
                        android:focusable="true"
                        android:minHeight="48dp"
                        android:minWidth="48dp"
                        android:gravity="center"
                        android:paddingBottom="@dimen/hmt_space_6"
                        android:text="@string/edit_tab_track"
                        android:textAppearance="@style/TextAppearance.HoldMyTrack.TitleSmall" />

                    <TextView
                        android:id="@+id/edit_tab_route"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/hmt_space_16"
                        android:clickable="true"
                        android:focusable="true"
                        android:minHeight="48dp"
                        android:minWidth="48dp"
                        android:gravity="center"
                        android:paddingBottom="@dimen/hmt_space_6"
                        android:text="@string/edit_tab_route"
                        android:textAppearance="@style/TextAppearance.HoldMyTrack.TitleSmall" />

                    <!-- Unsaved track changes (.edit-window__tab-dot). -->
                    <View
                        android:id="@+id/edit_tab_route_dot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/hmt_space_6"
                        android:background="@drawable/bg_panel_dot"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/edit_tab_photos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/hmt_space_16"
                        android:clickable="true"
                        android:focusable="true"
                        android:minHeight="48dp"
                        android:minWidth="48dp"
                        android:gravity="center"
                        android:paddingBottom="@dimen/hmt_space_6"
                        android:text="@string/photos_tab"
                        android:textAppearance="@style/TextAppearance.HoldMyTrack.TitleSmall" />

                    <!-- How many photos Save would leave (.edit-window__tab-count). -->
                    <TextView
                        android:id="@+id/edit_tab_photos_count"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/hmt_space_6"
                        android:layout_marginBottom="@dimen/hmt_space_6"
                        android:background="@drawable/bg_panel_badge"
                        android:importantForAccessibility="no"
                        android:paddingStart="@dimen/hmt_space_6"
                        android:paddingEnd="@dimen/hmt_space_6"
                        android:textColor="@color/hmt_accent_strong"
                        android:textFontWeight="700"
                        android:textSize="@dimen/hmt_text_xs"
                        android:visibility="gone"
                        tools:text="4" />

                    <!-- Unsaved photo changes. -->
                    <View
                        android:id="@+id/edit_tab_photos_dot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/hmt_space_6"
                        android:background="@drawable/bg_panel_dot"
                        android:visibility="gone" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_gravity="bottom"
                    android:background="@color/hmt_hairline" />
            </FrameLayout>

            <!-- Why the Route or Photos tab can't be used, after a tap on it. -->
            <TextView
                android:id="@+id/edit_tab_blocked"
                style="@style/Widget.HoldMyTrack.Hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/hmt_space_6"
                android:accessibilityLiveRegion="polite"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/edit_track_panel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Not typed into directly: a tap opens TrackTypePicker, the recording form's own
                     searchable list of the account's types with an "Add …" row for a new one. -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/edit_type_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/hmt_space_12"
                    android:hint="@string/edit_type"
                    app:endIconContentDescription="@string/edit_type"
                    app:endIconDrawable="@drawable/ic_chevron_down"
                    app:endIconMode="custom">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_type"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:cursorVisible="false"
                        android:focusable="false"
                        android:inputType="none" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/edit_name_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/hmt_space_10"
                    android:hint="@string/edit_name"
                    app:counterMaxLength="200"
                    app:placeholderText="@string/edit_name_placeholder">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textCapSentences"
                        android:maxLength="200" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/edit_description_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/hmt_space_10"
                    android:hint="@string/edit_description"
                    app:placeholderText="@string/edit_description_placeholder">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edit_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="top"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLength="2000"
                        android:maxLines="6"
                        android:minLines="3" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Several tracks: why Name and Description can't be set. -->
                <TextView
                    android:id="@+id/edit_multi_note"
                    style="@style/Widget.HoldMyTrack.Hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/hmt_space_6"
                    android:text="@string/edit_multi_reason"
                    android:visibility="gone" />
            </LinearLayout>

            <include layout="@layout/include_route_editor" />

            <include layout="@layout/include_photos_tab" />

            <TextView
                android:id="@+id/edit_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/hmt_space_10"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/hmt_danger"
                android:textSize="@dimen/hmt_text_md"
                android:visibility="gone" />

        </LinearLayout>
    </dev.holdmytrack.android.panel.MaxHeightScrollView>
</LinearLayout>