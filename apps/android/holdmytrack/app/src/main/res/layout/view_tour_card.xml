<?xml version="1.0" encoding="utf-8"?>
<!-- A tour step, a first-time card or the tour's offer (tour/TourOverlay): a title with the step's
     place, the explanation, and its buttons. TourOverlay shows the buttons each one needs. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.HoldMyTrack.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    app:cardElevation="@dimen/hmt_space_8"
    app:contentPadding="@dimen/hmt_space_20">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tour_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:textAppearance="@style/TextAppearance.HoldMyTrack.TitleMedium" />

            <TextView
                android:id="@+id/tour_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/hmt_space_12"
                android:textAppearance="@style/TextAppearance.HoldMyTrack.LabelMedium"
                android:textColor="@color/hmt_ink_muted" />
        </LinearLayout>

        <TextView
            android:id="@+id/tour_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hmt_space_8"
            android:textAppearance="@style/TextAppearance.HoldMyTrack.BodyMedium"
            android:textColor="@color/hmt_ink_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hmt_space_16"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/tour_skip"
                style="@style/Widget.HoldMyTrack.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/tour_back"
                style="@style/Widget.HoldMyTrack.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/hmt_space_8"
                android:text="@string/tour_back" />

            <Button
                android:id="@+id/tour_next"
                style="@style/Widget.HoldMyTrack.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>