<?xml version="1.0" encoding="utf-8"?>
<!-- The Private location editor, after the web's .private-locations__window: a sheet along the
     bottom of the map, the map live above it, so the circle it edits stays in view and its handle
     can be dragged. Its header stays put: Cancel, the title, Save. Under it Name, RADIUS with its
     readout and slider, a note, an error line and a saved one's Delete, scrolling under the header
     when the keyboard leaves too little room. It reaches the screen's bottom edge, its padding
     clearing the gesture bar, or rides on the keyboard while it's up (map/ChromeInsets.placeEditors),
     so Save is never under the keyboard. Clickable, so a touch on it never reaches the map. Filled
     by panel/PrivateLocationEditor. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/private_editor"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom"
    android:background="@drawable/bg_sheet"
    android:clickable="true"
    android:elevation="10dp"
    android:focusable="false"
    android:orientation="vertical"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/private_editor_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/hmt_space_4"
        android:paddingTop="@dimen/hmt_space_8"
        android:paddingEnd="@dimen/hmt_space_12"
        android:paddingBottom="@dimen/hmt_space_4">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/private_editor_cancel"
            style="@style/Widget.HoldMyTrack.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/edit_cancel" />

        <TextView
            android:id="@+id/private_editor_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/hmt_space_4"
            android:layout_marginEnd="@dimen/hmt_space_4"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.HoldMyTrack.TitleMedium" />

        <Button
            android:id="@+id/private_editor_save"
            style="@style/Widget.HoldMyTrack.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/edit_save" />
    </LinearLayout>

    <dev.holdmytrack.android.panel.MaxHeightScrollView
        android:id="@+id/private_editor_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingStart="@dimen/hmt_space_16"
        android:paddingEnd="@dimen/hmt_space_16"
        android:paddingBottom="@dimen/hmt_space_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/hmt_space_8"
                android:hint="@string/edit_name"
                app:placeholderText="@string/private_name_placeholder">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/private_editor_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapSentences"
                    android:maxLength="100" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/hmt_space_12"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/private_radius"
                    android:textAppearance="@style/TextAppearance.HoldMyTrack.PanelFilterLabel" />

                <TextView
                    android:id="@+id/private_editor_radius"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/hmt_ink_meta"
                    android:textSize="@dimen/hmt_text_xs" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/private_editor_slider"
                style="@style/Widget.HoldMyTrack.PanelSlider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-8dp"
                android:layout_marginEnd="-8dp"
                android:contentDescription="@string/private_radius"
                android:stepSize="10"
                android:valueFrom="50"
                android:valueTo="2000" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/private_editor_note"
                android:textColor="@color/hmt_ink_meta"
                android:textSize="@dimen/hmt_text_sm" />

            <TextView
                android:id="@+id/private_editor_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/hmt_space_8"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/hmt_danger"
                android:textSize="@dimen/hmt_text_sm"
                android:visibility="gone" />

            <!-- A saved location's Delete, apart from Save in the header. -->
            <Button
                android:id="@+id/private_editor_delete"
                style="@style/Widget.HoldMyTrack.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="-12dp"
                android:layout_marginTop="@dimen/hmt_space_4"
                android:text="@string/private_delete"
                android:textColor="@color/hmt_danger" />
        </LinearLayout>
    </dev.holdmytrack.android.panel.MaxHeightScrollView>
</LinearLayout>
