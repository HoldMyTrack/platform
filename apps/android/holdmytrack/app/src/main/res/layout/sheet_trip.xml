<?xml version="1.0" encoding="utf-8"?>
<!-- Create trip and Edit trip (panel/TripSheet.kt), after the web's TripDialog.tsx: what the
     Trip is made of (Create only), Name and Description, and the server's reason when a request
     fails. The sheet's toolbar (sheet_form) holds ✕ and Create trip / Save. The 200 and 2000
     are the server's maxTripNameLen and maxTripDescriptionLen (httpapi/trips.go). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/hmt_space_24"
    android:paddingTop="@dimen/hmt_space_4"
    android:paddingEnd="@dimen/hmt_space_24">

    <TextView
        android:id="@+id/trip_dialog_body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/hmt_space_8"
        android:textColor="@color/hmt_ink_secondary"
        android:textSize="@dimen/hmt_text_md" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/trip_dialog_name_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/trip_name"
        app:counterMaxLength="200"
        app:placeholderText="@string/trip_name_placeholder">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/trip_dialog_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="textCapSentences"
            android:maxLength="200" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/trip_dialog_description_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/hmt_space_10"
        android:hint="@string/trip_description"
        app:placeholderText="@string/trip_description_placeholder">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/trip_dialog_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="2000"
            android:maxLines="12"
            android:minLines="3" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/trip_dialog_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/hmt_space_10"
        android:accessibilityLiveRegion="polite"
        android:textColor="@color/hmt_danger"
        android:textSize="@dimen/hmt_text_md"
        android:visibility="gone" />
</LinearLayout>
