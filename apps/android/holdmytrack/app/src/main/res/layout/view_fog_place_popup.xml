<?xml version="1.0" encoding="utf-8"?>
<!-- The outline a tap picked in Fog (map/FogPlaces, docs/SPEC.md FR-4.2), the web's
     .fog-place-tip: its name, its kind and the places it lies in, and whether it's explored with
     how many of each level below it are, and a close button. Placed over the tap by FogPlaces. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fog_place_popup"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="top|start"
    android:background="@drawable/bg_spot_popup"
    android:clickable="true"
    android:elevation="6dp"
    android:focusable="false"
    android:maxWidth="272dp"
    android:orientation="vertical"
    android:paddingStart="@dimen/hmt_space_12"
    android:paddingTop="@dimen/hmt_space_8"
    android:paddingEnd="@dimen/hmt_space_4"
    android:paddingBottom="@dimen/hmt_space_8"
    android:visibility="gone">

    <!-- As wide as the popup, the close button at its end. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/fog_place_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:maxWidth="216dp"
            android:textColor="@color/hmt_ink"
            android:textSize="@dimen/hmt_text_md"
            android:textStyle="bold"
            tools:text="Parma" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/fog_place_close"
            style="@style/Widget.HoldMyTrack.Button.RowIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="-8dp"
            android:layout_marginBottom="-8dp"
            android:contentDescription="@string/fog_place_close"
            app:icon="@drawable/ic_x"
            app:iconSize="18dp"
            app:iconTint="@color/hmt_ink_muted" />
    </LinearLayout>

    <TextView
        android:id="@+id/fog_place_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="248dp"
        android:paddingEnd="@dimen/hmt_space_8"
        android:textColor="@color/hmt_ink_secondary"
        android:textSize="@dimen/hmt_text_sm"
        tools:text="City · Cuyahoga County, Ohio" />

    <TextView
        android:id="@+id/fog_place_state"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="248dp"
        android:paddingEnd="@dimen/hmt_space_8"
        android:textColor="@color/hmt_ink_secondary"
        android:textSize="@dimen/hmt_text_sm"
        tools:text="Explored" />
</LinearLayout>
