<?xml version="1.0" encoding="utf-8"?>
<!-- The map's Tracks sheet (panel/TracksPanel.kt): a bottom sheet the user drags between
     collapsed — its head alone — half the map and nearly all of it (BottomSheetBehavior; the
     expanded top stops under the map's top row). Its head is the date range on the Tracks
     tab — the range as a heading, ‹ › to move it, and the day scrubber under them. The other
     tabs have no head of their own, the bottom bar naming them. Everything under the
     head stays laid out while collapsed, just covered, so the list keeps its scroll position.
     Clickable, so a touch on it never reaches the map underneath. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/tracks_sheet"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_sheet"
    android:clickable="true"
    android:contentDescription="@string/panel_label"
    android:elevation="8dp"
    android:focusable="false"
    android:orientation="vertical"
    android:visibility="gone"
    app:behavior_fitToContents="false"
    app:behavior_halfExpandedRatio="0.5"
    app:behavior_hideable="false"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

    <!-- Everything the collapsed sheet shows; its bottom edge is the peek height
         (TracksPanel). Its bottom padding clears the record button, raised out of the bottom
         bar into the sheet's last few dp (activity_main.xml). -->
    <LinearLayout
        android:id="@+id/panel_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/hmt_space_20">

        <!-- The drag handle; a tap on it opens the sheet halfway, or closes it. -->
        <FrameLayout
            android:id="@+id/panel_handle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="-24dp"
            android:background="?attr/selectableItemBackground"
            android:contentDescription="@string/panel_expand">

            <!-- The bar is drawn in the top 24dp; the 48dp target reaches under the head's
                 first row, which takes no taps of its own. -->
            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_sheet_handle" />
        </FrameLayout>

        <!-- The Tracks tab's head: what the list holds, "6 tracks · 74.8 km · 9h 6m"
             (map/SheetChrome). -->
        <LinearLayout
            android:id="@+id/panel_summary_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/hmt_space_16"
            android:paddingEnd="@dimen/hmt_space_12"
            android:visibility="gone">

            <TextView
                android:id="@+id/panel_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/hmt_ink_meta"
                android:textSize="@dimen/hmt_text_sm"
                tools:text="6 tracks · 74.8 km · 9h 6m" />
        </LinearLayout>

        <!-- The toolbar, in the summary's place while a track is focused or checked. -->
        <include layout="@layout/include_track_actions" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/hmt_hairline" />

    <!-- The tabs' contents, one showing at a time. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- The Tracks tab: filters, toolbar, rows, footer. -->
        <LinearLayout
            android:id="@+id/panel_tracks_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- The master checkbox and its All / None / Invert, then the filters as chips
                 (.tracks-panel__filters): Type's dropdown, Dates, DISTANCE's slider in a popup
                 under its chip, and "Reset" while any is on. The row scrolls sideways when it
                 doesn't fit. -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_row_divider"
                android:overScrollMode="never"
                android:scrollbars="none">

            <LinearLayout
                android:id="@+id/panel_filters"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/hmt_space_4"
                android:paddingTop="@dimen/hmt_space_4"
                android:paddingEnd="@dimen/hmt_space_8"
                android:paddingBottom="@dimen/hmt_space_8">

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/panel_check_all"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <ImageButton
                    android:id="@+id/panel_select_menu"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="-12dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/panel_select_menu"
                    android:paddingStart="12dp"
                    android:paddingTop="17dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="17dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="@color/panel_select_icon" />

                <LinearLayout
                    android:id="@+id/panel_type_trigger"
                    style="@style/Widget.HoldMyTrack.FilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/hmt_space_4"
                    android:contentDescription="@string/panel_filter_by_type">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:text="@string/panel_type"
                        android:textAppearance="@style/TextAppearance.HoldMyTrack.FilterChip" />

                    <View
                        android:id="@+id/panel_type_dot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginStart="@dimen/hmt_space_6"
                        android:background="@drawable/bg_panel_dot"
                        android:visibility="gone" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="@dimen/hmt_space_6"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="@color/panel_ink_40" />
                </LinearLayout>

                <!-- Dates (docs/SPEC.md FR-5.12): the chip reads what's set, "Dates" for all
                     time, and opens From and To (map/DatesSheet). -->
                <LinearLayout
                    android:id="@+id/panel_dates"
                    style="@style/Widget.HoldMyTrack.FilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/hmt_space_8"
                    android:contentDescription="@string/dates_filter">

                    <TextView
                        android:id="@+id/panel_dates_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:text="@string/dates_name"
                        android:textAppearance="@style/TextAppearance.HoldMyTrack.FilterChip" />

                    <View
                        android:id="@+id/panel_dates_dot"
                        android:layout_width="6dp"
                        android:layout_height="6dp"
                        android:layout_marginStart="@dimen/hmt_space_6"
                        android:background="@drawable/bg_panel_dot"
                        android:visibility="gone" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="@dimen/hmt_space_6"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="@color/panel_ink_40" />
                </LinearLayout>

                <!-- DISTANCE (apps/web/src/ui/DistanceFilter.tsx): the chip reads the band, "any
                     distance" until a knob moves; gone when no two tracks differ in distance,
                     as on the web. -->
                <LinearLayout
                    android:id="@+id/panel_distance"
                    style="@style/Widget.HoldMyTrack.FilterChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/hmt_space_8"
                    android:contentDescription="@string/panel_distance">

                    <TextView
                        android:id="@+id/panel_distance_readout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:importantForAccessibility="no"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.HoldMyTrack.FilterChip"
                        tools:text="any distance" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="@dimen/hmt_space_6"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="@color/panel_ink_40" />
                </LinearLayout>

                <Button
                    android:id="@+id/panel_reset_filters"
                    style="@style/Widget.HoldMyTrack.Button.Link"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/hmt_space_4"
                    android:paddingStart="@dimen/hmt_space_8"
                    android:paddingEnd="@dimen/hmt_space_8"
                    android:text="@string/panel_reset"
                    android:textFontWeight="600"
                    android:textSize="@dimen/hmt_text_sm"
                    android:visibility="gone" />
            </LinearLayout>
            </HorizontalScrollView>

            <!-- The list's progress bar (.tracks-panel__progress): over the rows while a slow
                 reload is under way. Always 2dp tall, so showing it never moves the list. -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/panel_progress"
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:contentDescription="@string/panel_loading"
                android:indeterminate="true"
                android:visibility="invisible"
                app:indicatorColor="@color/hmt_accent"
                app:trackColor="@android:color/transparent"
                app:trackThickness="2dp" />

            <!-- The rows, then a note while empty and loading, when nothing matches, or when the read failed
                 (.tracks-panel__note, item_panel_note). A tap on the list's own empty space, or on
                 the note, clears the selection (TracksPanel.kt). -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/panel_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:scrollbars="vertical" />

            <!-- The target's summary (.tracks-panel__footer): "1 selected · 10 km". -->
            <TextView
                android:id="@+id/panel_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_list_top"
                android:paddingStart="@dimen/hmt_space_16"
                android:paddingTop="@dimen/hmt_space_12"
                android:paddingEnd="@dimen/hmt_space_16"
                android:paddingBottom="@dimen/hmt_space_12"
                android:textColor="@color/hmt_ink_hint"
                android:textSize="@dimen/hmt_text_md"
                tools:text="1 selected · 10 km" />
        </LinearLayout>

        <!-- The Trips tab (apps/web/src/ui/TripsTab.tsx): every Trip as a folder, the open
             one's description, statistics and rows under it. Filled by panel/TripsTab. -->
        <LinearLayout
            android:id="@+id/panel_trips_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/trips_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:overScrollMode="never"
                android:scrollbars="vertical" />
        </LinearLayout>

        <!-- The Sync tab: what's on this phone, waiting, to tick and send (panel/SyncTab). -->
        <include layout="@layout/include_sync_content" />

        <!-- The Library tab: every track the account keeps (panel/LibraryTab). -->
        <include layout="@layout/include_library_content" />
    </FrameLayout>
</LinearLayout>
