<?xml version="1.0" encoding="utf-8"?>
<!-- The Dates filter's From and To (map/DatesDialog): each its day or a hint, a tap to pick it,
     and ✕ while it's set. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/hmt_space_8">

    <LinearLayout
        android:id="@+id/dates_after"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/hmt_space_24"
        android:paddingEnd="@dimen/hmt_space_12">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dates_after"
                android:textAppearance="@style/TextAppearance.HoldMyTrack.TitleMedium" />

            <TextView
                android:id="@+id/dates_after_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.HoldMyTrack.BodyMedium"
                android:textColor="@color/hmt_ink_meta" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dates_after_clear"
            style="@style/Widget.HoldMyTrack.Button.MapIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_x" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dates_before"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="56dp"
        android:orientation="horizontal"
        android:paddingStart="@dimen/hmt_space_24"
        android:paddingEnd="@dimen/hmt_space_12">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/dates_before"
                android:textAppearance="@style/TextAppearance.HoldMyTrack.TitleMedium" />

            <TextView
                android:id="@+id/dates_before_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.HoldMyTrack.BodyMedium"
                android:textColor="@color/hmt_ink_meta" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/dates_before_clear"
            style="@style/Widget.HoldMyTrack.Button.MapIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:icon="@drawable/ic_x" />
    </LinearLayout>
</LinearLayout>
