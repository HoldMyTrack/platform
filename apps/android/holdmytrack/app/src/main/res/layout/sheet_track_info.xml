<?xml version="1.0" encoding="utf-8"?>
<!-- The toolbar's Info as a bottom sheet (panel/TrackInfoSheet.kt): ✕ and the title, the
     server's lines as label and value, the pace bands' legend while the map draws them, and the
     server's note. -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/hmt_space_20">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/info_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:theme="@style/ThemeOverlay.HoldMyTrack.FormSheetToolbar"
            app:navigationContentDescription="@string/picker_close"
            app:navigationIcon="@drawable/ic_x"
            app:navigationIconTint="@color/hmt_ink"
            app:title="@string/info_title"
            app:titleTextAppearance="?attr/textAppearanceTitleMedium" />

        <TextView
            android:id="@+id/info_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:paddingStart="@dimen/hmt_space_16"
            android:paddingEnd="@dimen/hmt_space_16"
            android:text="@string/panel_loading"
            android:textColor="@color/hmt_ink_meta" />

        <LinearLayout
            android:id="@+id/info_lines"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/hmt_space_16"
            android:paddingEnd="@dimen/hmt_space_16" />

        <!-- The pace bands' legend, slowest to fastest. -->
        <LinearLayout
            android:id="@+id/info_bands"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hmt_space_12"
            android:contentDescription="@string/info_bands"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/hmt_space_16"
            android:paddingEnd="@dimen/hmt_space_16"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:text="@string/info_slower"
                android:textColor="@color/hmt_ink_meta"
                android:textSize="@dimen/hmt_text_sm" />

            <LinearLayout
                android:id="@+id/info_band_steps"
                android:layout_width="0dp"
                android:layout_height="6dp"
                android:layout_marginStart="@dimen/hmt_space_8"
                android:layout_marginEnd="@dimen/hmt_space_8"
                android:layout_weight="1"
                android:importantForAccessibility="no"
                android:orientation="horizontal" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:importantForAccessibility="no"
                android:text="@string/info_faster"
                android:textColor="@color/hmt_ink_meta"
                android:textSize="@dimen/hmt_text_sm" />
        </LinearLayout>

        <TextView
            android:id="@+id/info_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hmt_space_12"
            android:paddingStart="@dimen/hmt_space_16"
            android:paddingEnd="@dimen/hmt_space_16"
            android:textColor="@color/hmt_ink_meta"
            android:textSize="@dimen/hmt_text_sm"
            android:visibility="gone" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
