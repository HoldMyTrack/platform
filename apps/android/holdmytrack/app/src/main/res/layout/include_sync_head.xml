<?xml version="1.0" encoding="utf-8"?>
<!-- The top of the Sync tab's list (panel/SyncTab): why this account can't sync, if it can't;
     what the last run did and what it couldn't (selectable, since a rejection's reason is what
     someone would paste into a bug report); Health Connect's row — when it was last read, and
     Refresh — over its window, what it wouldn't give, or what to set up; the recordings not sent
     yet, with Retry; then the type filters and Select all over the rows. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="@dimen/hmt_space_8">

    <TextView
        android:id="@+id/sync_account_notice"
        style="@style/Widget.HoldMyTrack.Notice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/hmt_space_16"
        android:layout_marginEnd="@dimen/hmt_space_16"
        android:layout_marginBottom="@dimen/hmt_space_8"
        android:visibility="gone" />

    <TextView
        android:id="@+id/sync_results"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/hmt_space_16"
        android:layout_marginEnd="@dimen/hmt_space_16"
        android:layout_marginBottom="@dimen/hmt_space_8"
        android:accessibilityLiveRegion="polite"
        android:textAppearance="@style/TextAppearance.HoldMyTrack.CardRowSub"
        android:textIsSelectable="true"
        android:visibility="gone" />

    <TextView
        android:id="@+id/sync_problems"
        style="@style/Widget.HoldMyTrack.Notice.Error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/hmt_space_16"
        android:layout_marginEnd="@dimen/hmt_space_16"
        android:layout_marginBottom="@dimen/hmt_space_8"
        android:textIsSelectable="true"
        android:visibility="gone" />

    <!-- Health Connect, when it was last read (sync/WaitingLoader), and Refresh, which reads it
         again (panel/SyncSourceRow). -->
    <LinearLayout
        android:id="@+id/sync_source_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/hmt_space_16"
        android:paddingEnd="@dimen/hmt_space_4"
        android:visibility="gone">

        <TextView
            android:id="@+id/sync_source_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.HoldMyTrack.CardRowTitle"
            tools:text="Health Connect · read Nov 24, 07:12" />

        <Button
            android:id="@+id/sync_refresh"
            style="@style/Widget.HoldMyTrack.Button.RowIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/sync_refresh"
            android:tooltipText="@string/sync_refresh"
            app:icon="@drawable/ic_refresh_cw" />
    </LinearLayout>

    <TextView
        android:id="@+id/sync_source_note"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/hmt_space_16"
        android:layout_marginEnd="@dimen/hmt_space_16"
        android:layout_marginBottom="@dimen/hmt_space_8"
        android:textColor="@color/hmt_ink_meta"
        android:textSize="@dimen/hmt_text_sm"
        android:visibility="gone"
        tools:text="Health Connect sessions from the last 3 months. Older ones stay in Health Connect." />

    <!-- Health Connect switched off, or not set up yet: Settings › Sync (SyncActivity). -->
    <Button
        android:id="@+id/sync_source_settings"
        style="@style/Widget.HoldMyTrack.Button.Link"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/hmt_space_16"
        android:layout_marginBottom="@dimen/hmt_space_8"
        android:minHeight="48dp"
        android:text="@string/sync_open_sources"
        android:visibility="gone" />

    <!-- Recordings on this phone not sent yet, which send themselves (sync/RecordingSends), and
         Retry, which sends them again now, refused ones too. -->
    <LinearLayout
        android:id="@+id/sync_recordings_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/hmt_space_16"
        android:paddingEnd="@dimen/hmt_space_4"
        android:visibility="gone">

        <TextView
            android:id="@+id/sync_recordings_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="@style/TextAppearance.HoldMyTrack.CardRowTitle"
            tools:text="2 recordings not sent yet" />

        <Button
            android:id="@+id/sync_recordings_retry"
            style="@style/Widget.HoldMyTrack.Button.RowIcon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/sync_recordings_retry"
            android:tooltipText="@string/sync_recordings_retry"
            app:icon="@drawable/ic_refresh_cw" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sync_filters"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="@dimen/hmt_space_8">

        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/sync_types"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/sync_types"
                android:paddingStart="@dimen/hmt_space_16"
                android:paddingEnd="@dimen/hmt_space_8"
                app:singleLine="true" />
        </HorizontalScrollView>

        <Button
            android:id="@+id/sync_select_all"
            style="@style/Widget.HoldMyTrack.Button.Link"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:text="@string/sync_select_all"
            android:textFontWeight="600" />
    </LinearLayout>
</LinearLayout>
