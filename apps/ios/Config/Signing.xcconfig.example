// Copy to Signing.xcconfig (not committed) once there is an Apple Developer team: Debug and
// Release both read it. A simulator build needs no team, but without one it has no Sign in with
// Apple, whose entitlement needs a team's provisioning profile; CI builds that way.

DEVELOPMENT_TEAM = ABCDE12345
CODE_SIGN_ENTITLEMENTS = Config/HoldMyTrack.entitlements
