// Copy to Local.xcconfig (not committed) to point Debug builds at another origin than the web's
// dev server (Debug.xcconfig): compose's API port, or this Mac's name.local for a phone on the
// same network, since the dev server listens on this Mac alone. The site's pages don't save there.

HMT_API_BASE_URL = http:$(SLASH)$(SLASH)localhost:8080
