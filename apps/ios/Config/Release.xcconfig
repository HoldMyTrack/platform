// Release: the App Store build. Its API origin is fixed and set after every include, so no
// developer's override reaches it; Local.xcconfig isn't read here at all.

#include "Base.xcconfig"

#include? "Signing.xcconfig"

DEBUG_INFORMATION_FORMAT = dwarf-with-dsym
SWIFT_COMPILATION_MODE = wholemodule
SWIFT_OPTIMIZATION_LEVEL = -O
VALIDATE_PRODUCT = YES

HMT_API_BASE_URL = https:$(SLASH)$(SLASH)holdmytrack.com
