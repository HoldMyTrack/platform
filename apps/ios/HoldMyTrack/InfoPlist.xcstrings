{
  "sourceLanguage" : "en",
  "strings" : {
    "NSCameraUsageDescription" : {
      "comment" : "The camera permission prompt, shown when Settings' avatar takes a photo.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HoldMyTrack uses the camera only when you take a photo for your avatar in Settings."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HoldMyTrack использует камеру, только когда вы снимаете фото для аватара в настройках."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "The location permission prompt, shown on the first Find my location or capture.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HoldMyTrack shows where you are on the map when you tap Find my location, and checks you're inside a place you capture."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HoldMyTrack показывает на карте, где вы находитесь, когда вы нажимаете «Моё местоположение», и проверяет, что вы внутри места, которое захватываете."
          }
        }
      }
    },
    "SpotCapture" : {
      "comment" : "The precise location prompt when capturing a place with only approximate location on.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capturing a place counts only a precise position, so a place you walk past isn't captured."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для захвата места учитывается только точное местоположение, чтобы не захватить место, мимо которого вы проходите."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
