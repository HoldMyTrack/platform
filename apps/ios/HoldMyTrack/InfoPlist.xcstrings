      "comment" : "A file type the app opens, as Files and the share sheet name it.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Трек GPX"
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "The camera permission prompt, shown when Settings' avatar takes a photo.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HoldMyTrack uses the camera only when you take a photo for your avatar in Settings."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HoldMyTrack использует камеру, только когда вы снимаете фото для аватара в настройках."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "The location permission prompt, shown on the first Find my location or capture.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HoldMyTrack shows where you are on the map when you tap Find my location, records the tracks you start with the record button, and checks you're inside a place you capture."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HoldMyTrack показывает на карте, где вы находитесь, когда вы нажимаете «Моё местоположение», записывает треки, которые вы начинаете кнопкой записи, и проверяет, что вы внутри места, которое захватываете."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription" : {
      "comment" : "The prompt for adding to Photos, shown when a map image export is first saved.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HoldMyTrack only adds the map images you export to your photos; it never reads them."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HoldMyTrack только добавляет в «Фото» картинки карты, которые вы экспортируете, и никогда их не читает."
          }
        }
      }
    },
    "Recording" : {
      "comment" : "The one-time precise location prompt, shown when a recording starts with approximate location allowed.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A recording keeps only precise positions, so the track follows the way you went."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запись сохраняет только точные координаты, чтобы трек повторял ваш путь."
          }
        }
      }
    },
    "SpotCapture" : {
      "comment" : "The precise location prompt when capturing a place with only approximate location on.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Capturing a place counts only a precise position, so a place you walk past isn't captured."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для захвата места учитывается только точное местоположение, чтобы не захватить место, мимо которого вы проходите."
          }
        }
      }
    },
    "TCX track" : {
      "comment" : "A file type the app opens, as Files and the share sheet name it.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Трек TCX"
          }
        }
      }
    }
  },
  "version" : "1.0"
}