{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ couldn't be read." : {
      "comment" : "Upload: a picked file couldn't be read; the placeholder is its name.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось прочитать %@."
          }
        }
      }
    },
    "%@ is over %lld MB." : {
      "comment" : "Upload: a file past the size limit: its name and the limit.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ больше %lld МБ."
          }
        }
      }
    },
    "%@ isn't a GPX, FIT or TCX file." : {
      "comment" : "Upload: a picked file of another kind; the placeholder is its name.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — не файл GPX, FIT или TCX."
