    "HoldMyTrack needs location access to show where you are. Turn it on in Settings." : {
      "comment" : "Map: Find my location with location access refused.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "HoldMyTrack нужен доступ к местоположению, чтобы показать, где вы. Включите его в Настройках."
