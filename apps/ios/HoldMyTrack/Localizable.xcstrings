    "%@ wasn't sent: the server couldn't be reached." : {
      "comment" : "Upload: a file's upload had no answer.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не отправлен: не удалось связаться с сервером."
          }
        }
      }
    },
    "%@ will be deleted for good, with its track and its part of Fog of War and Heatmap." : {
      "comment" : "Activities panel: Delete's confirmation; the placeholder names what is deleted and its distance.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — будет удалено навсегда вместе с треком и его вкладом в «туман войны» и тепловую карту."
          }
        }
      }
    },
    "%@: archives aren't imported. Upload the GPX, FIT or TCX files inside it." : {
      "comment" : "Upload: a picked .zip; the placeholder is its name.",
