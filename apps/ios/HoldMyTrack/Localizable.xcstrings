        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ миль/ч"
          }
        }
      }
    },
    "%@ sent you a copy of “%@” (%@)." : {
      "comment" : "Stories tab: a copy waiting: who sent it, the Story's name, and its activity count.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ отправляет вам копию «%@» (%@)."
