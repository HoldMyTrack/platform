        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: архивы не загружаются. Загрузите файлы GPX, FIT или TCX из него."
          }
        }
      }
    },
    "%@: processed %lld of %lld" : {
      "comment" : "Upload: an import still running: its title, files done and in all.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: обработано %lld из %lld"
