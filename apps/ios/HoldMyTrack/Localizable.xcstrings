    },
    "Create your account" : {
      "comment" : "Sign-in screen: title in sign-up mode.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Создание аккаунта"
          }
        }
      }
    },
    "Don't have an account? Create one" : {
      "comment" : "Sign-in screen: switches from signing in to signing up.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нет аккаунта? Создайте его"
