          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы выйдете из аккаунта на всех устройствах, а всё, что в нём, исчезнет в течение нескольких минут. Для подтверждения введите адрес своей почты — %@."
          }
        }
      }
    },
    "delete.email" : {
      "comment" : "Delete account: the email field.",
      "extractionState" : "manual",
