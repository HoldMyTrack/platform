        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — будет удалено навсегда вместе с треком и его вкладом в «туман войны» и тепловую карту."
          }
        }
      }
    },
    "%@ – %@" : {
      "comment" : "Dates: both ends set.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – %@"
          }
        }
      }
    },
    "%@ – %@ %@ · %@–%@" : {
      "comment" : "Track editor: the range's distances along the track, its unit, and the times at its ends.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – %@ %@ · %@–%@"
          }
        }
