    "Sign in to HoldMyTrack" : {
      "comment" : "Sign-in screen: title in sign-in mode.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вход в HoldMyTrack"
          }
        }
      }
    },
    "Sign in to see your tracks, fog of war and heatmap on the map. The demo needs no signup: a shared, ready-made account you can look around but not change." : {
      "comment" : "Sign-in screen: what signing in and the demo give.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Войдите, чтобы увидеть свои треки, «туман войны» и тепловую карту. Демо не требует регистрации: это общий готовый аккаунт, его можно смотреть, но не изменять."
          }
        }
      }
    },
    "Sign out" : {
      "comment" : "Ends the session on the server and on the phone.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выйти"
          }
        }
      }
    },
    "Stories" : {
      "comment" : "Tab bar: Stories.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Истории"
          }
        }
      }
    },
    "Stories come with the Activities panel." : {
      "comment" : "Stories tab: its screen is still to come.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Истории появятся вместе с панелью занятий."
          }
        }
      }
    },
    "Sync" : {
      "comment" : "Tab bar: Sync.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Синхр."
          }
        }
      }
    },
    "Sync history comes with the site's pages." : {
      "comment" : "Sync tab: its screen is still to come.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "История синхронизации появится вместе со страницами сайта."
          }
        }
      }
    },
    "The demo account" : {
      "comment" : "Home screen: who is signed in, for the shared demo account.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Демо-аккаунт"
          }
        }
      }
    },
    "The map can't reach its tile server. Your network may be blocking it." : {
      "comment" : "Map: no basemap tile arrived.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карта не может связаться со своим сервером. Возможно, его блокирует ваша сеть."
          }
        }
      }
    },
    "The map couldn't load." : {
      "comment" : "Map: the map's documents couldn't be fetched.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось загрузить карту."
          }
        }
      }
    },
    "This version of the app is too old to use. Update it to keep using HoldMyTrack." : {
      "comment" : "Update screen: the server turns this build away.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эта версия приложения слишком старая. Обновите её, чтобы и дальше пользоваться HoldMyTrack."
          }
        }
      }
    },
    "Try again" : {
      "comment" : "Repeats a session check that couldn't reach the server.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Повторить"
          }
        }
      }
    },
    "Try the demo" : {
      "comment" : "Sign-in screen: starts a session on the shared demo account.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Попробовать демо"
          }
        }
      }
    },
    "Update" : {
      "comment" : "Update screen: opens the App Store listing.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обновить"
          }
        }
      }
    },
    "Update HoldMyTrack" : {
      "comment" : "Update screen: title.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обновите HoldMyTrack"
          }
        }
      }
    },
    "Verify your email" : {
      "comment" : "Verify email screen: title.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подтвердите почту"
          }
        }
      }
    },
    "We sent a confirmation link to %@. Open it to unlock your account — your map starts working as soon as you do." : {
      "comment" : "Verify email screen: the placeholder is the account's email address.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мы отправили ссылку для подтверждения на %@. Перейдите по ней, чтобы открыть доступ к аккаунту, — карта заработает сразу после этого."
          }
        }
      }
    },
    "You" : {
      "comment" : "Tab bar: You.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы"
          }
        }
      }
    },
    "Your Facebook account didn't share an email address, and HoldMyTrack needs one. Try again and allow access to your email, or sign up with email and password." : {
      "comment" : "Sign-in screen: Facebook shared no email.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш аккаунт Facebook не передал адрес электронной почты, а он нужен HoldMyTrack. Попробуйте ещё раз и разрешите доступ к почте или зарегистрируйтесь по почте и паролю."
          }
        }
      }
    },
    "Your email isn't confirmed yet. Open the link in the email we sent, then tap Continue." : {
      "comment" : "Verify email screen: Continue found the address still unconfirmed.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Почта ещё не подтверждена. Перейдите по ссылке из письма и нажмите «Продолжить»."
          }
        }
      }
    },
    "Your map is still being updated, so Fog and Heatmap may be incomplete for now. They'll refresh on their own." : {
      "comment" : "Map: coverage is still being redrawn.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Карта ещё обновляется, поэтому Туман и Тепловая карта пока могут быть неполными. Они обновятся сами."
          }
        }
      }
    },
    "answered %lld" : {
      "comment" : "The first screen: the API answered /healthz with this HTTP status.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ответил с кодом %lld"
          }
        }
      }
    },
    "answered something other than /healthz" : {
      "comment" : "The first screen: the API answered, but not with /healthz's JSON.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ответил не так, как /healthz"
          }
        }
      }
    },
    "or" : {
      "comment" : "Sign-in screen: between email sign-in and the providers.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "или"
          }
        }
      }
    },
    "reachable, build %@" : {
      "comment" : "The first screen: the API answered /healthz; the build is the server's commit.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "доступен, сборка %@"
          }
        }
      }
    },
    "unreachable" : {
      "comment" : "The first screen: no answer from the API.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "недоступен"
          }
        }
      }
