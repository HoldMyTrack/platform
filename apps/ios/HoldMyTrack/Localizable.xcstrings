{
  "sourceLanguage" : "en",
  "strings" : {
    "Already have an account? Sign in" : {
      "comment" : "Sign-in screen: switches from signing up to signing in.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Уже есть аккаунт? Войдите"
          }
        }
      }
    },
    "An account with this email already exists. Sign in the way you usually do, or use “Forgot password?” to set a password." : {
      "comment" : "Sign-in screen: Facebook's email belongs to an existing account, which Facebook is never linked to.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аккаунт с этой почтой уже существует. Войдите так, как обычно, или задайте пароль через «Забыли пароль?»."
          }
        }
      }
    },
    "Bike paths" : {
      "comment" : "Layers menu: the bike path layer.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Велодорожки"
          }
        }
      }
    },
    "Checking your session…" : {
      "comment" : "Shown while the server confirms a session kept from an earlier launch.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверяем вход…"
          }
        }
      }
    },
    "Continue" : {
      "comment" : "Verify email screen: asks the server again whether the address is confirmed.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продолжить"
          }
        }
      }
    },
    "Continue with Facebook" : {
      "comment" : "Sign-in screen: Facebook sign-in.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Войти через Facebook"
          }
        }
      }
    },
    "Continue with Google" : {
      "comment" : "Sign-in screen: Google sign-in.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Войти через Google"
          }
        }
      }
    },
    "Could not sign in." : {
      "comment" : "Sign-in screen: a sign-in failed and the server sent no message.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось войти."
          }
        }
      }
    },
    "Couldn't reach HoldMyTrack. Check your connection and try again." : {
      "comment" : "The server didn't answer a session check.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось связаться с HoldMyTrack. Проверьте подключение и попробуйте ещё раз."
          }
        }
      }
    },
    "Couldn't sign in with Apple. Please try again." : {
      "comment" : "Sign-in screen: Sign in with Apple failed.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось войти через Apple. Попробуйте ещё раз."
          }
        }
      }
    },
    "Couldn't sign in with Facebook. Please try again." : {
      "comment" : "Sign-in screen: the Facebook round trip failed.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось войти через Facebook. Попробуйте ещё раз."
