    },
    "A copy of your tracks, Trips, photos and settings, as zip files. We email you when it's ready; the download lasts 7 days." : {
      "comment" : "Download your data: what the download holds.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Копия ваших треков, путешествий, фото и настроек в zip-архивах. Мы напишем, когда она будет готова; скачать её можно в течение 7 дней."
          }
        }
      }
    },
    "About" : {
      "comment" : "You tab: opens the About page.",
