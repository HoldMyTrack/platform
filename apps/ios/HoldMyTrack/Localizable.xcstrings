      "comment" : "Sign-in screen: the email field.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Эл. почта"
          }
        }
      }
    },
    "Forgot password?" : {
      "comment" : "Sign-in screen: opens the web's password reset page.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Забыли пароль?"
          }
        }
      }
    },
