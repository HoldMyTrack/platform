{
  "sourceLanguage" : "en",
  "strings" : {
    ".gpx, .fit or .tcx files, up to %lld at a time." : {
      "comment" : "Upload: the screen's explanation: the file cap and size limit.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Файлы .gpx, .fit или .tcx, до %lld за раз."
          }
        }
      }
    },
    "“%@”" : {
      "comment" : "Tracks tab: one track named as an action's target.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@»"
          }
        }
      }
    },
    "%@ – %@" : {
      "comment" : "Dates: both ends set.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – %@"
          }
        }
      }
    },
    "%@ – %@ %@ · %@–%@" : {
      "comment" : "Route editor: the range's distances along the route, its unit, and the times at its ends.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – %@ %@ · %@–%@"
          }
        }
      }
    },
    "%@ away" : {
      "comment" : "Capture: the distance to the place.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Осталось %@"
          }
        }
      }
    },
    "%@ ft" : {
      "comment" : "A Private location's radius in feet.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ фт"
          }
        }
      }
    },
    "%@ is a .zip archive, which can't be imported. Upload the GPX, FIT or TCX files inside it instead." : {
      "comment" : "Upload: a picked .zip; the placeholder is its name.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — zip-архив, его импортировать нельзя. Загрузите файлы GPX, FIT или TCX из него."
          }
        }
      }
    },
    "%@ is too large: at most %lld MB." : {
      "comment" : "Upload: a file past the size limit: its name and the limit.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ слишком большой: не больше %lld МБ."
          }
        }
      }
    },
    "%@ isn't a .gpx, .fit or .tcx file, so it wasn't sent." : {
      "comment" : "Upload: a picked file of another kind; the placeholder is its name.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — не файл .gpx, .fit или .tcx, он не отправлен."
          }
        }
      }
    },
    "%@ km/h" : {
      "comment" : "A speed in kilometres an hour.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ км/ч"
          }
        }
      }
    },
    "%@ m" : {
      "comment" : "A Private location's radius in metres.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ м"
          }
        }
      }
    },
    "%@ mph" : {
      "comment" : "A speed in miles an hour.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ миль/ч"
          }
        }
      }
    },
    "%@ sent you a copy of “%@” · %@" : {
      "comment" : "Trips tab: a copy waiting: who sent it, the Trip's name, and its track count.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ отправляет вам копию «%@» · %@"
          }
        }
      }
    },
    "%@ was already uploaded before." : {
      "comment" : "Upload: the server had this exact file already.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ уже был загружен раньше."
          }
        }
      }
    },
    "%@ will be permanently deleted — its route, fog coverage, and any performance records it contributed to. This can't be undone." : {
      "comment" : "Delete: one track, named with its distance.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ будет удалён навсегда — вместе с маршрутом, покрытием «тумана войны» и всеми рекордами, в которые он входил. Это нельзя отменить."
          }
        }
      }
    },
    "%@ will be permanently deleted — their routes, fog coverage, and any performance records they contributed to. This can't be undone." : {
      "comment" : "Delete: several checked tracks, counted with their distance.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ будут удалены навсегда — вместе с маршрутами, покрытием «тумана войны» и всеми рекордами, в которые они входили. Это нельзя отменить."
          }
        }
      }
    },
    "%@–%@ %@" : {
      "comment" : "Tracks panel: the Distance filter's band: the shortest, the longest, and the unit.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@–%@ %@"
          }
        }
      }
    },
    "%@: %@" : {
      "comment" : "A file that couldn't be added, and why: a picked photo on the Photos tab, or an upload.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: %@"
          }
        }
      }
    },
    "%@: processed %lld of %lld" : {
      "comment" : "Upload: an import still running: its title, files done and in all.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: обработано %lld из %lld"
          }
        }
      }
    },
    "%@: the file couldn't be read" : {
      "comment" : "Upload: a picked file couldn't be read; the placeholder is its name.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: не удалось прочитать файл"
          }
