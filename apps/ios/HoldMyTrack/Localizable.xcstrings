        }
      }
    },
    "%@ was imported before." : {
      "comment" : "Upload: the server had this exact file already.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ уже был загружен раньше."
