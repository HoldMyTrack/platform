    "delete.hint" : {
      "comment" : "Delete account: what goes.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deletes your account and everything in it, for good: every track and the files you uploaded, your photos, Trips, Private locations and captured places, and the recordings on this phone that haven't synced. It can't be undone, and backups keep it for up to 8 weeks."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удаляет аккаунт и всё, что в нём, насовсем: все треки и загруженные файлы, фотографии, путешествия, приватные и отмеченные места, а также записи на этом телефоне, которые ещё не синхронизированы. Это нельзя отменить, а в резервных копиях данные хранятся ещё до 8 недель."
          }
        }
      }
    },
