      }
    },
    "%@: the server couldn't be reached" : {
      "comment" : "Upload: a file that wasn't sent because the server didn't answer.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: не удалось связаться с сервером"
