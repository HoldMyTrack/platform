{
  "sourceLanguage" : "en",
  "strings" : {
    "%@ away" : {
      "comment" : "Capture: the distance to the place.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Осталось %@"
          }
        }
      }
    },
    "%@ couldn't be read." : {
      "comment" : "Upload: a picked file couldn't be read; the placeholder is its name.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось прочитать %@."
          }
        }
      }
    },
    "%@ is over %lld MB." : {
      "comment" : "Upload: a file past the size limit: its name and the limit.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ больше %lld МБ."
          }
        }
      }
    },
    "%@ isn't a GPX, FIT or TCX file." : {
      "comment" : "Upload: a picked file of another kind; the placeholder is its name.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — не файл GPX, FIT или TCX."
          }
        }
      }
    },
    "%@ km/h" : {
      "comment" : "A speed in kilometres an hour; the placeholder is the number.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ км/ч"
          }
        }
      }
    },
    "%@ mph" : {
      "comment" : "A speed in miles an hour; the placeholder is the number.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ миль/ч"
          }
        }
      }
    },
    "%@ sent you a copy of “%@” (%@)." : {
      "comment" : "Trips tab: a copy waiting: who sent it, the Trip's name, and its track count.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ отправляет вам копию «%@» (%@)."
          }
        }
      }
    },
    "%@ was imported before." : {
      "comment" : "Upload: the server had this exact file already.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ уже был загружен раньше."
          }
        }
      }
    },
    "%@ wasn't sent: %@" : {
      "comment" : "Upload: the server refused a file: its name and the reason.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не отправлен: %@"
          }
        }
      }
    },
    "%@ wasn't sent: the server couldn't be reached." : {
      "comment" : "Upload: a file's upload had no answer.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ не отправлен: не удалось связаться с сервером."
          }
        }
      }
    },
    "%@ will be deleted for good, with its route and its part of Fog of War." : {
      "comment" : "Tracks panel: Delete's confirmation; the placeholder names what is deleted and its distance.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ — будет удалён навсегда вместе с маршрутом и его вкладом в «туман войны»."
          }
        }
      }
    },
    "%@ – %@" : {
      "comment" : "Dates: both ends set.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – %@"
          }
        }
      }
    },
    "%@ – %@ %@ · %@–%@" : {
      "comment" : "Route editor: the range's distances along the route, its unit, and the times at its ends.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ – %@ %@ · %@–%@"
          }
        }
      }
    },
    "%@: %@" : {
      "comment" : "Photos tab: a picked file that couldn't be added, and why.",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: %@"
          }
        }
      }
    },
    "%@: archives aren't imported. Upload the GPX, FIT or TCX files inside it." : {
      "comment" : "Upload: a picked .zip; the placeholder is its name.",
