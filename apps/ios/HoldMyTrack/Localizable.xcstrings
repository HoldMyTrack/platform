    "tour.fog.body" : {
      "comment" : "The tour and Fog's first-time card.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Everywhere you've ever been, for all time: Dates and the filters don't apply here. Fog clears whole places, from countries down to towns, and zoomed in, exactly along your routes. Auto picks the level from the zoom. Pick a level to keep it at every zoom, or Exact to clear the fog only along your routes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все места, где вы когда-либо были, за всё время: даты и фильтры здесь не действуют. Туман открывает места целиком, от стран до городов, а вблизи — точно вдоль ваших маршрутов. «Авто» выбирает уровень по масштабу. Выберите уровень, чтобы оставить его на любом масштабе, или «Точно», чтобы туман рассеивался только вдоль маршрутов."
          }
        }
      }
    },
    "tour.fog.title" : {
      "comment" : "The tour and Fog's first-time card.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fog of War"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Туман"
          }
        }
      }
    },
    "tour.fog_cities.body" : {
      "comment" : "The demo's tour: Fog's town level.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zoomed out, a whole town clears once any track is in it. Tap a place to see its name and how much of it you've explored."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При отдалении целый город открывается, как только в нём есть хоть один трек. Коснитесь места, чтобы увидеть его название и сколько в нём посещено."
          }
        }
      }
    },
