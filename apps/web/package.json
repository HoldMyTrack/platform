{
  "name": "holdmytrack-web",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "basemap": "./scripts/build-basemap.sh",
    "build:style": "node scripts/build-style.mjs",
    "gen:api-types": "openapi-typescript ../../services/server/api/openapi.yaml --array-length -o src/apiSchema.ts",
    "verify:api-types": "openapi-typescript ../../services/server/api/openapi.yaml --array-length -o src/apiSchema.ts --check",
    "verify:style": "node scripts/build-style.mjs --check",
    "verify:map": "node --test --test-concurrency=1 tests/smoke.mjs tests/flows.mjs",
    "verify:build": "node --test tests/build.mjs",
    "test:unit": "node --test \"tests/*.test.mjs\"",
    "test:coverage": "c8 npm run test:unit",
    "gen:rule-cases": "node scripts/generate-rule-cases.mjs",
    "shots:landing": "node scripts/landing-shots/shoot.mjs"
  },
  "dependencies": {
    "@protomaps/basemaps": "5.7.2",
    "lucide-react": "1.72.0",
    "maplibre-gl": "6.18.0",
    "pmtiles": "4.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "c8": "12.0.0",
    "eslint": "10.15.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "js-yaml": "5.5.0",
    "openapi-typescript": "7.13.0",
    "playwright": "1.65.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8"
  }
}
